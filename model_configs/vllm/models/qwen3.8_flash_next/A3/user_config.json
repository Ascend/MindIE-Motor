{
  "version": "v2.0",
  "motor_deploy_config": {
    "p_instances_num": 1,
    "d_instances_num": 1,
    "single_p_instance_pod_num": 1,
    "single_d_instance_pod_num": 1,
    "p_pod_npu_num": 8,
    "d_pod_npu_num": 8,
    "image_name": "<请按实际情况填写镜像名称>",
    "job_id": "mindie-motor",
    "hardware_type": "800I_A3",
    "weight_mount_path": "<请按实际情况填写模型权重文件的访问路径>",
    "dshm_size": "128Gi"
  },
  "motor_controller_config": {},
  "motor_coordinator_config": {},
  "motor_engine_prefill_config": {
    "engine_type": "vllm",
    "engine_config": {
      "data_parallel_size": 2,
      "tensor_parallel_size": 2,
      "pipeline_parallel_size": 2,
      "data_parallel_rpc_port": 9000,
      "served_model_name": "qwen38-flash-next-a3-pd",
      "model": "<请按实际情况填写模型权重文件的访问路径>",
      "enable_expert_parallel": true,
      "max-model-len": 262144,
      "max-num-batched-tokens": 8192,
      "max-num-seqs": 32,
      "enforce-eager": true,
      "async-scheduling": true,
      "enable-prefix-caching": true,
      "trust-remote-code": true,
      "gpu_memory_utilization": 0.9,
      "quantization": "ascend",
      "speculative-config": {
        "method": "qwen3_5_mtp",
        "num_speculative_tokens": 3,
        "enforce_eager": true
      },
      "additional-config": {
        "enable_cpu_binding": true,
        "enable_shared_expert_dp": true,
        "multistream_overlap_shared_expert": true,
        "ascend_compilation_config": {
          "fuse_norm_quant": false
        },
        "enable_flashcomm1": true,
        "enable_prefill_mc2": true,
        "enable_fused_mc2": 0
      },
      "kv_transfer_config": {
        "kv_connector": "MultiConnector",
        "kv_role": "kv_producer",
        "kv_connector_extra_config": {
          "connectors": [
            {
              "kv_connector": "MooncakeConnectorV2",
              "kv_role": "kv_producer",
              "kv_port": 32600,
              "kv_connector_extra_config": {
                "prefill": {
                  "dp_size": 2,
                  "tp_size": 2,
                  "pp_size": 2
                },
                "decode": {
                  "dp_size": 4,
                  "tp_size": 2
                }
              }
            },
            {
              "kv_connector": "AscendStoreConnector",
              "kv_role": "kv_producer",
              "kv_connector_extra_config": {
                "backend": "memcache",
                "lookup_rpc_port": "qwen38_pool_p",
                "use_layerwise": false
              }
            }
          ]
        },
        "engine_id": "0",
        "kv_port": "32600"
      },
      "mamba-cache-mode": "align",
      "mamba-ssm-cache-dtype": "bfloat16",
      "engram-config": {
        "cpu_offload": true,
        "dp_shared_memory": true
      }
    }
  },
  "motor_engine_decode_config": {
    "engine_type": "vllm",
    "engine_config": {
      "data_parallel_size": 4,
      "tensor_parallel_size": 2,
      "pipeline_parallel_size": 1,
      "data_parallel_rpc_port": 9000,
      "served_model_name": "qwen38-flash-next-a3-pd",
      "model": "<请按实际情况填写模型权重文件的访问路径>",
      "enable_expert_parallel": true,
      "max-model-len": 262144,
      "max-num-batched-tokens": 8192,
      "max-num-seqs": 32,
      "async-scheduling": true,
      "trust-remote-code": true,
      "gpu_memory_utilization": 0.9,
      "quantization": "ascend",
      "compilation-config": {
        "cudagraph_mode": "FULL_DECODE_ONLY"
      },
      "speculative-config": {
        "method": "qwen3_5_mtp",
        "num_speculative_tokens": 3,
        "enforce_eager": false
      },
      "additional-config": {
        "enable_cpu_binding": true,
        "enable_shared_expert_dp": true,
        "multistream_overlap_shared_expert": true,
        "ascend_compilation_config": {
          "enable_npugraph_ex": true,
          "enable_static_kernel": true,
          "fuse_norm_quant": false,
          "enable_super_kernel": false
        },
        "enable_flashcomm1": true,
        "scheduler_config": {
          "recompute_scheduler_enable": true
        }
      },
      "kv_transfer_config": {
        "kv_connector": "MultiConnector",
        "kv_role": "kv_consumer",
        "kv_connector_extra_config": {
          "connectors": [
            {
              "kv_connector": "MooncakeConnectorV2",
              "kv_role": "kv_consumer",
              "kv_port": 32700,
              "kv_connector_extra_config": {
                "prefill": {
                  "dp_size": 2,
                  "tp_size": 2,
                  "pp_size": 2
                },
                "decode": {
                  "dp_size": 4,
                  "tp_size": 2
                }
              }
            },
            {
              "kv_connector": "AscendStoreConnector",
              "kv_role": "kv_consumer",
              "kv_connector_extra_config": {
                "backend": "memcache",
                "lookup_rpc_port": "qwen38_pool_d",
                "use_layerwise": false
              }
            }
          ]
        },
        "engine_id": "1",
        "kv_port": "32700"
      },
      "enable-prefix-caching": true,
      "mamba-cache-mode": "align",
      "mamba-ssm-cache-dtype": "bfloat16",
      "engram-config": {
        "cpu_offload": true,
        "dp_shared_memory": true
      }
    }
  },
  "kv_cache_store_config": {
    "backend": "memcache",
    "port": 50088,
    "local_service_mode": "standalone",
    "local_config_path": "/usr/local/Ascend/Motor/conf/mmc-local-inprocess.conf"
  }
