{
  "version": "v2.0",
  "motor_deploy_config": {
    "deploy_mode": "infer_service_set",
    "hybrid_instances_num": 1,
    "single_hybrid_instance_pod_num": 1,
    "hybrid_pod_npu_num": 16,
    "image_name": "<请按实际情况填写镜像名称>",
    "job_id": "mindie-motor",
    "hardware_type": "800I_A3",
    "weight_mount_path": "<请按实际情况填写模型权重文件的访问路径>"
  },
  "motor_controller_config": {},
  "motor_coordinator_config": {
    "scheduler_config": {
      "deploy_mode": "single_node"
    }
  },
  "motor_engine_union_config": {
    "engine_type": "vllm",
    "engine_config": {
      "served_model_name": "dsv41",
      "model": "<请按实际情况填写模型权重文件的访问路径>",
      "gpu_memory_utilization": 0.9,
      "data_parallel_size": 4,
      "tensor_parallel_size": 4,
      "pipeline_parallel_size": 1,
      "enable_expert_parallel": true,
      "data_parallel_rpc_port": 9000,
      "max-model-len": 150000,
      "max-num-batched-tokens": 8192,
      "max-num-seqs": 32,
      "block-size": 128,
      "async-scheduling": true,
      "quantization": "ascend",
      "safetensors-load-strategy": "lazy",
      "tokenizer-mode": "deepseek_v41",
      "tool-call-parser": "deepseek_v41",
      "enable-auto-tool-choice": true,
      "reasoning-parser": "deepseek_v41",
      "compilation-config": {
        "cudagraph_mode": "FULL_DECODE_ONLY"
      },
      "additional-config": {
        "enable_cpu_binding": true,
        "enable_shared_expert_dp": true,
        "enable_dsa_cp": true,
        "ascend_compilation_config": {
          "enable_npugraph_ex": true,
          "enable_static_kernel": false
        },
        "enable_fused_mc2": 1,
        "enable_flashcomm1": true
      },
      "engram-config": {
        "cpu_offload": true,
        "dp_shared_memory": true
      }
    }
  }
}
