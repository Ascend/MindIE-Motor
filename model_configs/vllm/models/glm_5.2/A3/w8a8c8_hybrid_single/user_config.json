{
  "version": "v2.0",
  "motor_deploy_config": {
    "deploy_mode": "infer_service_set",
    "hybrid_instances_num": 1,
    "single_hybrid_instance_pod_num": 1,
    "hybrid_pod_npu_num": 16,
    "image_name": "<请按实际情况填写镜像名称>",
    "job_id": "mindie-motor",
    "hardware_type": "800I_A3",
    "weight_mount_path": "<请按实际情况填写模型权重文件的访问路径>"
  },
  "motor_controller_config": {},
  "motor_coordinator_config": {
    "scheduler_config": {
      "deploy_mode": "single_node"
    }
  },
  "motor_engine_union_config": {
    "engine_type": "vllm",
    "engine_config": {
      "served_model_name": "glm",
      "model": "<请按实际情况填写模型权重文件的访问路径>",
      "gpu_memory_utilization": 0.92,
      "data_parallel_size": 1,
      "tensor_parallel_size": 16,
      "pipeline_parallel_size": 1,
      "data_parallel_rpc_port": 9000,
      "seed": 1024,
      "max-model-len": 32768,
      "max-num-batched-tokens": 8192,
      "max-num-seqs": 12,
      "trust-remote-code": true,
      "quantization": "ascend",
      "tool-call-parser": "glm47",
      "enable-auto-tool-choice": true,
      "reasoning-parser": "glm47",
      "speculative-config": {
        "num_speculative_tokens": 3,
        "method": "deepseek_mtp",
        "enforce_eager": true
      },
      "compilation-config": {
        "cudagraph_mode": "FULL_DECODE_ONLY"
      },
      "additional-config": {
        "enable_dsa_cp": true,
        "multistream_overlap_shared_expert": true,
        "enable_balance_scheduling": true,
        "enable_flashcomm1": true
      },
      "api-server-count": 1,
      "kv-cache-dtype": "int8",
      "attention_config": {
        "indexer_kv_dtype": "int8"
      }
    }
  }
}
