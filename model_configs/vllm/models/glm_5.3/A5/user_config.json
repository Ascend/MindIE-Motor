              "kv_port": "30000",
              "kv_connector_extra_config": {
                "prefill": {
                  "pp_layer_partition": "42,36"
                }
              }
            },
            {
              "kv_connector": "AscendStoreConnector",
              "kv_role": "kv_producer",
              "kv_connector_extra_config": {
                "lookup_rpc_port": "0",
                "backend": "memcache",
                "use_layerwise": true
              }
            }
          ]
