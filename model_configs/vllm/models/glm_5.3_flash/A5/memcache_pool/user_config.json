    "single_d_instance_pod_num": 1,
    "p_pod_npu_num": 8,
    "d_pod_npu_num": 8,
    "image_name": "<请按实际情况填写镜像名称>",
    "job_id": "mindie-motor",
    "hardware_type": "Ascend950",
    "weight_mount_path": "<请按实际情况填写模型权重文件的访问路径>",
    "prefill_node_selector": {}
  },
  "motor_controller_config": {},
  "motor_coordinator_config": {
    "scheduler_config": {
      "prefill_scheduler_type": "kv_cache_affinity",
      "decode_scheduler_type": "load_balance"
