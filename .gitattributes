# Normalize repository text files to LF.
* text=auto eol=lf

# Preserve CRLF for Windows-native command scripts.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Preserve existing model JSON line endings during directory moves.
model_configs/**/env.json -text
model_configs/**/user_config.json -text
