@@ -58,2 +58,21 @@

+def _motor_build_anthropic_usage(prompt_tokens, completion_tokens, usage):
+    """Backport of upstream _build_anthropic_usage: map vLLM cached_tokens to
+    Anthropic cache_read_input_tokens; input_tokens = max(0, total - cached); cache
+    creation has no vLLM analog (0). Fields omitted when cache info absent."""
+    cached = None
+    if usage is not None:
+        details = getattr(usage, "prompt_tokens_details", None)
+        if details is not None:
+            cached = getattr(details, "cached_tokens", None)
+    if cached is not None:
+        return AnthropicUsage(
+            input_tokens=max(0, prompt_tokens - cached),
+            output_tokens=completion_tokens or 0,
+            cache_read_input_tokens=cached,
+            cache_creation_input_tokens=0,
+        )
+    return AnthropicUsage(input_tokens=prompt_tokens, output_tokens=completion_tokens or 0)
+
+
 class AnthropicServingMessages(OpenAIServingChat):
