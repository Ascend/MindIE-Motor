# vllm_anthropic_serving.patch
#
# Backports for the Anthropic Messages serving of the bundled vLLM fork
# (entrypoints/anthropic/{protocol,serving}.py, Apache-2.0,
# Copyright contributors to the vLLM project), targeting vLLM releases/v0.23.0:
# - AnthropicMessagesRequest: add the request_id field and forward it (required
#   by pyMotor PD trigger/metaserver prefill replay; without it the prefill KV is
#   registered under a random id and the decode side hangs). kv_transfer_params
#   already exists upstream in 0.23.0 and is intentionally not patched.
# - AnthropicUsage: map prompt_tokens_details.cached_tokens to
#   cache_read_input_tokens / cache_creation_input_tokens (input_tokens
#   clamped non-negative)
# - messages_full_converter: tolerate empty/partial tool_call arguments
# - emit stop_reason="tool_use" when the response carries tool_use blocks
# Applied by patch/patch_apply.py (patch -p0, fuzz allowed).

--- entrypoints/anthropic/protocol.py
+++ entrypoints/anthropic/protocol.py
@@ -138,2 +138,6 @@
     )
+    # motor: PD trigger/metaserver prefill replay must reuse the coordinator's
+    # request id, otherwise the prefill KV is registered under a random id and
+    # the decode side waits forever.
+    request_id: str | None = None
     chat_template_kwargs: dict[str, Any] | None = Field(
--- entrypoints/anthropic/serving.py
