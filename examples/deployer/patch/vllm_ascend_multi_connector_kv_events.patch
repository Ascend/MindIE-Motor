+
+    def get_kv_connector_kv_cache_events(self) -> "KVConnectorKVEvents | None":
+        """Collect kv cache events from all child connectors.
+
+        Proxy for child connectors' worker-side kv cache events. Without
+        this, a top-level MultiConnector silently drops connector events
+        (upstream vLLM leaves this unimplemented as a TODO).
+        """
+        # motor-patch: kv-events proxy (do not remove)
+        combined = None
+        for c in self._connectors:
+            events = c.get_kv_connector_kv_cache_events()
+            if events is None:
+                continue
+            if combined is None:
+                combined = events
+            else:
+                combined.add_events(events.get_all_events())
+                combined.increment_workers(events.get_number_of_workers())
+        return combined
+
