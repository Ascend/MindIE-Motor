+                pooling_params=None,
+                is_prefetch_req=True,
+            )
+            self._add_request(company_req)
+            logger.info(
+                f"adding company req for unfinish req {num_unfinished_requests} and prefetch count {len(self.prefetch_running_queue)}"
+            )
