+                                "@head_or_tp_rank:0", f"@head_or_tp_rank:{i}", 1
+                            )
+                        )
+ 
+                for i in range(1, self.pp_size):
+                    for item in multi_tp_keys:
+                        keys.append(
+                            item.replace(  # type: ignore[attr-defined]
+                                "@pp_rank:0", f"@pp_rank:{i}", 1
+                            )
+                        )
+                keys.extend(multi_tp_keys)
+ 
+            if not keys:
+                return
