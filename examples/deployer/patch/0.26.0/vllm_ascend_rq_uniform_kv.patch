index 000000000..1e3b5c3fe
--- /dev/null
+++ b/vllm_ascend/ops/mla_rq_uniform_ops.py
@@ -0,0 +1,130 @@
+# Copyright (c) 2025-2026 The vllm-ascend Authors. All Rights Reserved.
+"""MLA-RQ Scheme A ops: paged absorb decode and chunked-prefill dequant."""
+
+from __future__ import annotations
+
+import torch
+
+
+def _scheme_a_ignored_args(device, dtype, latent: int, rope: int):
+    key = (device, dtype, latent, rope)
+    cached = _SCHEME_A_IGNORED.get(key)
+    if cached is None:
+        cached = (
+            torch.zeros(1, 1, latent, dtype=dtype, device=device),
+            torch.zeros(1, 1, rope, dtype=dtype, device=device),
+            torch.zeros(1, latent, latent, dtype=dtype, device=device),
+            torch.zeros(1, latent, 1, dtype=dtype, device=device),
+        )
+        _SCHEME_A_IGNORED[key] = cached
+    return cached
+
+
+_SCHEME_A_IGNORED: dict = {}
+
+
+def mla_scheme_a_paged_decode(
+    ql_nope: torch.Tensor,
+    q_pe: torch.Tensor,
+    latent_cache: torch.Tensor,
+    k_pe: torch.Tensor,
+    block_table: torch.Tensor,
+    seq_lens: list[int],
+    block_size: int,
+    scale: float,
+    rotation: torch.Tensor,
+    rotation_t: torch.Tensor,
+    num_kv_heads: int,
+    kv_lora_rank: int,
+    rope_dim: int,
+    actual_seq_lengths_q: list[int] | None = None,
+    *,
+    out: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Decode absorb over a Scheme A latent cache.
+
+    The op dequants by ``block_table`` and runs path B
+    (``ql' = ql @ R^T``, ``o = (P @ y) @ R``) before returning.
+    ``max_kv > 0`` selects that attention result. ``rotation_t`` is accepted
+    so callers can keep the cached pair; the op uses ``rotation``.
+
+    ``actual_seq_lengths_q`` / ``seq_lens`` are host ``int[]`` lists (same as
+    native MLA ``actual_seq_qlen`` / ``actual_seq_kvlen`` and Full RQ MSD).
+
+    Returns latent context ``[H, B, L]`` for ``W_UV``.
+    """
+    from vllm_ascend.ops.jiuwen_ops import jiuwen_op
+
+    del rotation_t, num_kv_heads, rope_dim
+
+    batch = ql_nope.shape[0]
+    if batch != len(seq_lens) or batch != block_table.shape[0]:
+        raise RuntimeError(
+            f"decode batch mismatch: ql={batch} seqs={len(seq_lens)} table={tuple(block_table.shape)}"
+        )
+    if any(seq_len < 0 for seq_len in seq_lens):
+        raise RuntimeError(f"decode seq_len must be non-negative, got {seq_lens}")
+    if max(seq_lens) <= 0:
+        raise RuntimeError(f"decode needs a positive seq_len, got {seq_lens}")
+    device = ql_nope.device
+    dtype = ql_nope.dtype
+    if block_table.dtype != torch.int32 or block_table.device != device or not block_table.is_contiguous():
+        block_table = block_table.to(device=device, dtype=torch.int32).contiguous()
+    if ql_nope.dtype != rotation.dtype or not ql_nope.is_contiguous():
+        ql_nope = ql_nope.to(dtype=rotation.dtype).contiguous()
+    if q_pe.dtype != rotation.dtype or not q_pe.is_contiguous():
+        q_pe = q_pe.contiguous()
+    total_kv = sum(seq_lens)
+    max_kv = max(seq_lens)
+    if actual_seq_lengths_q is None:
+        q_lens = list(range(1, batch + 1))
+    else:
+        if len(actual_seq_lengths_q) < batch:
+            raise RuntimeError(
+                f"actual_seq_lengths_q len {len(actual_seq_lengths_q)} < batch {batch}"
+            )
+        q_lens = list(actual_seq_lengths_q[:batch])
+    kv_lens = list(seq_lens)
+    _, _, w_uk, w_uv = _scheme_a_ignored_args(device, dtype, kv_lora_rank, q_pe.shape[-1])
+
+    return jiuwen_op("rq_uniform_fia_mla_latent_paged")(
+        ql_nope,
+        q_pe,
+        latent_cache,
+        k_pe,
+        block_table,
+        q_lens,
+        kv_lens,
+        w_uk,
+        w_uv,
+        rotation,
+        int(block_size),
+        float(scale),
+        int(batch),
+        int(total_kv),
+        int(max_kv),
+        out,
+    )
+
+
+def mla_dequant_paged_latent(
+    latent_cache: torch.Tensor,
+    rotation: torch.Tensor,
+    block_table: torch.Tensor,
+    context_lens: torch.Tensor,
+    seq_starts: torch.Tensor,
+    block_size: int,
+    total_tokens: int,
+) -> torch.Tensor:
+    """Restore fp latent ``c`` for one chunked-prefill history chunk."""
+    from vllm_ascend.ops.jiuwen_ops import jiuwen_op
+
+    return jiuwen_op("rq_uniform_dequant_mla_latent")(
+        latent_cache,
+        rotation,
+        block_table,
+        context_lens,
+        seq_starts,
+        int(block_size),
+        int(total_tokens),
+    )
diff --git a/vllm_ascend/ops/rq_uniform_tables.py b/vllm_ascend/ops/rq_uniform_tables.py
new file mode 100644
index 000000000..82f753536
--- /dev/null
+++ b/vllm_ascend/ops/rq_uniform_tables.py
@@ -0,0 +1,137 @@
+# Copyright (c) 2025-2026 The vllm-ascend Authors. All Rights Reserved.
+#
+# This code is based on the vllm-ascend project (https://github.com/vllm-project/vllm-ascend).
+"""Shared quantization tables for the Ascend RqUniform attention backend.
+
+The RqUniform K8V4 / K4V4 operators quantize Haar-rotated K/V into the
+packed cache: the pack op consumes ``R^T`` and the fused-infer-attention ops
+consume ``(R^T, R)``. The rotation uses the same deterministic construction
+as the ``rq_uniform-npu`` reference (seed=42), so caches written by this
+backend are byte-compatible with the standalone operator tests.
+"""
+
+from __future__ import annotations
+
+import torch
+
+_ROTATION_SEED = 42
+_HEAD_SIZE = 128
+
+# Per-token-per-head cache footprint (bytes) of each storage path.
+# * k8v4: every 16-token sub-block stores 16*(D+4) key + 16*(D/2+4) value
+#   bytes per head (D=128 -> 2112/1088; D=256 -> 4160/2112).
+# * k4v4: every 16-token sub-block stores 1088 B key + 1088 B value per head.
+RQ_UNIFORM_K8V4_SUB_BLOCK_ROWS = 16
+RQ_UNIFORM_K8V4_SUPPORTED_HEAD_SIZES = (128, 256)
+
+
+def rq_uniform_k8v4_head_size_ok(head_size: int) -> bool:
+    return int(head_size) in RQ_UNIFORM_K8V4_SUPPORTED_HEAD_SIZES
+
+
+def k8v4_key_block_stride(head_size: int) -> int:
+    """16-row key tile bytes: D=128 -> 2112, D=256 -> 4160."""
+    if not rq_uniform_k8v4_head_size_ok(head_size):
+        raise ValueError(
+            f"k8v4 head_size must be one of "
+            f"{RQ_UNIFORM_K8V4_SUPPORTED_HEAD_SIZES}, got {head_size}"
+        )
+    return RQ_UNIFORM_K8V4_SUB_BLOCK_ROWS * (int(head_size) + 4)
+
+
+def k8v4_value_block_stride(head_size: int) -> int:
+    """16-row value tile bytes: D=128 -> 1088, D=256 -> 2112."""
+    if not rq_uniform_k8v4_head_size_ok(head_size):
+        raise ValueError(
+            f"k8v4 head_size must be one of "
+            f"{RQ_UNIFORM_K8V4_SUPPORTED_HEAD_SIZES}, got {head_size}"
+        )
+    return RQ_UNIFORM_K8V4_SUB_BLOCK_ROWS * (int(head_size) // 2 + 4)
+
+
+_rotation_cache: dict[int, torch.Tensor] = {}
+
+
+def generate_haar_rotation(dim: int, seed: int = _ROTATION_SEED) -> torch.Tensor:
+    """Deterministic Haar orthogonal matrix (QR with sign correction, CPU)."""
+    gen = torch.Generator(device="cpu").manual_seed(seed)
+    # Model init runs under ``with torch.device("npu")``. An omitted device
+    # is rewritten to npu, which rejects this CPU generator.
+    g = torch.randn((dim, dim), generator=gen, dtype=torch.float32, device="cpu")
+    q, r = torch.linalg.qr(g)
+    s = torch.sign(torch.diag(r))
+    s[s == 0] = 1.0
+    return q * s.unsqueeze(0)
+
+
+def _haar_rotation(dim: int) -> torch.Tensor:
+    cached = _rotation_cache.get(dim)
+    if cached is None:
+        cached = generate_haar_rotation(dim, _ROTATION_SEED)
+        _rotation_cache[dim] = cached
+    return cached
+
+
+def _to_device_dtype(t: torch.Tensor, device: torch.device, dtype: torch.dtype) -> torch.Tensor:
+    target = dtype if dtype in (torch.float16, torch.bfloat16) else torch.float16
+    # See latent_rotation_tables: clone after H2D for a clean ND buffer.
+    return t.to(device=device, dtype=target).contiguous().clone()
+
+
+# Device-resident rotation tables, cached per (device index, dtype, dim). The
+# tables are read-only constants: building them once keeps every forward
+# free of H2D copies (an H2D copy per step would also be illegal inside an
+# ACL graph capture, where GLOBAL mode forbids host-device transfers).
+_device_rotation_cache: dict[tuple[int, str, str, int], tuple[torch.Tensor, torch.Tensor]] = {}
+
+
+def rq_uniform_rotation_tables(
+    device: torch.device, dtype: torch.dtype, head_size: int = _HEAD_SIZE
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Return ``(R^T, R)`` for the RqUniform pack/attention ops.
+
+    ``R^T`` feeds the pack op (and the FIA ``rotation_key``); ``R`` feeds the
+    FIA ``rotation_value``. Results are cached on-device per
+    (device, dtype, head_size); the matrices are [head_size, head_size].
+    """
+    target = dtype if dtype in (torch.float16, torch.bfloat16) else torch.float16
+    key = (device.index or 0, str(target), str(device.type), int(head_size))
+    cached = _device_rotation_cache.get(key)
+    if cached is None:
+        rotation = _haar_rotation(int(head_size))
+        rotation_t = rotation.T.contiguous()
+        cached = (
+            _to_device_dtype(rotation_t, device, target),
+            _to_device_dtype(rotation, device, target),
+        )
+        _device_rotation_cache[key] = cached
+    return cached[0].clone(), cached[1].clone()
+
+
+_latent_rotation_cache: dict[tuple[str, int, str, int], tuple[torch.Tensor, torch.Tensor]] = {}
+
+
+def latent_rotation_tables(
+    device: torch.device, dtype: torch.dtype, dim: int
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Return ``(R^T, R)`` for MLA latent RqUniform.
+
+    The Haar matrix is built once on CPU and copied to ``device`` once per
+    ``(device, dtype, dim)``. Later calls return the same storage.
+    """
+    key = (str(device.type), int(device.index or 0), str(dtype), int(dim))
+    cached = _latent_rotation_cache.get(key)
+    if cached is None:
+        rotation = _haar_rotation(int(dim))
+        rotation_t = rotation.transpose(0, 1).contiguous()
+        # Store a clean ND copy after H2D. Callers must not reuse the returned
+        # tensors across pack/fuse: those ops can mutate the buffer in place
+        # (observed: first tiny-amp call looks fine, later real-amp fuse cos
+        # collapses unless each use gets a fresh clone).
+        cached = (
+            rotation_t.to(device=device, dtype=dtype).contiguous().clone(),
+            rotation.to(device=device, dtype=dtype).contiguous().clone(),
+        )
+        _latent_rotation_cache[key] = cached
+    # Fresh clone per call so pack/fuse cannot poison the cache.
+    return cached[0].clone(), cached[1].clone()
