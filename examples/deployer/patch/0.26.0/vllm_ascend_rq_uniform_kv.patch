+            and kv_cache_dtype in _ASCEND_RQ_UNIFORM_SET
+            and kv_cache_dtype not in get_args(sel.CacheDType)
+        ):
+            sel.CacheDType = _merged_cache_dtype_literal(sel.CacheDType)  # type: ignore[attr-defined]
