+def _merged_cache_dtype_literal(base_literal) -> type:
+    """Union upstream CacheDType args with Ascend RQ names."""
+    current = get_args(base_literal)
+    merged = tuple(dict.fromkeys((*current, *ASCEND_RQ_UNIFORM_CACHE_DTYPES)))
+    return Literal.__getitem__(merged)  # type: ignore[misc,return-value]
+
+
+def _install_cache_config_init_patch() -> None:
+    """Accept Ascend-only cache_dtype values without relying on Literal rebuild."""
+    from vllm.config.cache import CacheConfig
+
+    if getattr(CacheConfig, "_ascend_rq_uniform_cache_dtype_patched", False):
+        return
+
+    orig_init = CacheConfig.__init__
+
+    def __init__(self, *args, **kwargs):  # type: ignore[no-untyped-def]
+        raw = kwargs.get("cache_dtype")
+        swap_back: str | None = None
+        if isinstance(raw, str) and raw in _ASCEND_RQ_UNIFORM_SET:
+            swap_back = raw
+            kwargs = {**kwargs, "cache_dtype": _UPSTREAM_CACHE_DTYPE_STANDIN}
