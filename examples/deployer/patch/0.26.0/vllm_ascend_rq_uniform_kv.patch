--- /dev/null
+++ b/vllm_ascend/hybrid_kv_page.py
@@ -0,0 +1,272 @@
+# Copyright (c) 2026 Huawei Technologies Co., Ltd. All Rights Reserved.
+"""Hybrid GDN + Full-attn k8v4 page geometry (D=128 and D=256).
+
+Formulas match ``script/xrx/TQ_K8V4_35B_FULL.md``:
+  k_1h = D + 4, v_1h = D/2 + 4
+  ★    = max(S, B × k_1h × H)
+  page = conv + ★ + B × v_1h × H
+  B*   = 128 × ceil(S / (128 × k_1h × H))
+
+One BlockPool, unified page. Full packed-K and GDN SSM share the ★ band
+(the shorter side pads). They must not both be live on the same block id.
+"""
+
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+from typing import Any
+
+import torch
+from vllm.utils.torch_utils import get_dtype_size
+
+KERNEL_BLOCK_SIZE = 128
+K8V4_TILE_ROWS = 16
+K8V4_META_BYTES = 4  # two fp16 scalars per row
+K8V4_SUPPORTED_HEAD_SIZES = (128, 256)
+
+
+def k8v4_head_size_ok(head_size: int) -> bool:
+    return int(head_size) in K8V4_SUPPORTED_HEAD_SIZES
+
+
+def k8v4_key_bytes_per_token_head(head_size: int) -> int:
+    """int8 code + 2×fp16 meta. D=256 → 260; D=128 → 132."""
+    if not k8v4_head_size_ok(head_size):
+        raise ValueError(f"k8v4 head_size must be 128 or 256, got {head_size}")
+    return int(head_size) + K8V4_META_BYTES
+
+
+def k8v4_val_bytes_per_token_head(head_size: int) -> int:
+    """int4 code + 2×fp16 meta. D=256 → 132; D=128 → 68."""
+    if not k8v4_head_size_ok(head_size):
+        raise ValueError(f"k8v4 head_size must be 128 or 256, got {head_size}")
+    return int(head_size) // 2 + K8V4_META_BYTES
+
+
+def k8v4_key_tile_bytes(head_size: int) -> int:
+    """16-row SoA tile. D=256 → 4160; D=128 → 2112."""
+    return K8V4_TILE_ROWS * k8v4_key_bytes_per_token_head(head_size)
+
+
+def k8v4_val_tile_bytes(head_size: int) -> int:
+    """16-row SoA tile. D=256 → 2112; D=128 → 1088."""
+    return K8V4_TILE_ROWS * k8v4_val_bytes_per_token_head(head_size)
+
+
+def k8v4_key_packed_width(block_size: int, head_size: int = 128) -> int:
+    if block_size % K8V4_TILE_ROWS != 0:
+        raise ValueError(
+            f"k8v4 block_size must be a multiple of {K8V4_TILE_ROWS}, got {block_size}"
+        )
+    return (block_size // K8V4_TILE_ROWS) * k8v4_key_tile_bytes(head_size)
+
+
+def k8v4_value_packed_width(block_size: int, head_size: int = 128) -> int:
+    if block_size % K8V4_TILE_ROWS != 0:
+        raise ValueError(
+            f"k8v4 block_size must be a multiple of {K8V4_TILE_ROWS}, got {block_size}"
+        )
+    return (block_size // K8V4_TILE_ROWS) * k8v4_val_tile_bytes(head_size)
+
+
+def k8v4_cache_page_tokens(key_cache: torch.Tensor, head_size: int) -> int:
+    """Tokens stored in one cache page (kernel page after hybrid split)."""
+    tile = k8v4_key_tile_bytes(head_size)
+    last = int(key_cache.shape[-1])
+    if last % tile != 0:
+        raise ValueError(
+            f"key_cache last dim {last} is not a multiple of k8v4 tile {tile}"
+        )
+    return (last // tile) * K8V4_TILE_ROWS
+
+
+def b_fill(*, ssm_bytes: int, num_kv_heads: int, head_size: int) -> int:
+    """Packed-K fill point: smallest 128-aligned B with B × k_tok ≥ S."""
+    k_tok = k8v4_key_bytes_per_token_head(head_size) * num_kv_heads
+    return KERNEL_BLOCK_SIZE * math.ceil(
+        ssm_bytes / (KERNEL_BLOCK_SIZE * k_tok)
+    )
+
+
+@dataclass(frozen=True)
+class HybridK8v4Page:
+    block_size: int
+    num_kv_heads: int
+    head_size: int
+    conv_bytes: int
+    ssm_bytes: int
+    k_tok: int
+    v_tok: int
+    star_bytes: int
+    v_band_bytes: int
+    page_bytes: int
+    key_packed_per_head: int
+    value_packed_per_head: int
+
+    @property
+    def kernel_pages_per_physical(self) -> int:
+        return self.block_size // KERNEL_BLOCK_SIZE
+
+
+def compute_hybrid_k8v4_page(
+    *,
+    conv_bytes: int,
+    ssm_bytes: int,
+    num_kv_heads: int,
+    head_size: int,
+    block_size: int | None = None,
+) -> HybridK8v4Page:
+    k_tok = k8v4_key_bytes_per_token_head(head_size) * num_kv_heads
+    v_tok = k8v4_val_bytes_per_token_head(head_size) * num_kv_heads
+    b = b_fill(
+        ssm_bytes=ssm_bytes, num_kv_heads=num_kv_heads, head_size=head_size
+    ) if block_size is None else int(block_size)
+    if b % KERNEL_BLOCK_SIZE != 0:
+        raise ValueError(f"block_size must be a multiple of {KERNEL_BLOCK_SIZE}, got {b}")
+    # Share the ★ band: the shorter of S and packed K pads in-row.
+    star = max(int(ssm_bytes), b * k_tok)
+    v_band = b * v_tok
+    return HybridK8v4Page(
+        block_size=b,
+        num_kv_heads=num_kv_heads,
+        head_size=head_size,
+        conv_bytes=int(conv_bytes),
+        ssm_bytes=int(ssm_bytes),
+        k_tok=k_tok,
+        v_tok=v_tok,
+        star_bytes=star,
+        v_band_bytes=v_band,
+        page_bytes=int(conv_bytes) + star + v_band,
+        key_packed_per_head=k8v4_key_packed_width(b, head_size),
+        value_packed_per_head=k8v4_value_packed_width(b, head_size),
+    )
+
+
+def mamba_conv_ssm_bytes(spec: Any) -> tuple[int, int]:
+    """conv = min(state bytes), ssm = max(state bytes) — same as patch_mamba."""
+    conv_shape, conv_dtype, ssm_shape, ssm_dtype = mamba_conv_ssm_shapes(spec)
+    return (
+        math.prod(conv_shape) * get_dtype_size(conv_dtype),
+        math.prod(ssm_shape) * get_dtype_size(ssm_dtype),
+    )
+
+
+def mamba_conv_ssm_shapes(
+    spec: Any,
+) -> tuple[tuple[int, ...], torch.dtype, tuple[int, ...], torch.dtype]:
+    sizes = [
+        (math.prod(shape) * get_dtype_size(dtype), shape, dtype)
+        for shape, dtype in zip(spec.shapes, spec.dtypes)
+    ]
+    if not sizes:
+        raise ValueError("MambaSpec has no shapes")
+    sizes_sorted = sorted(sizes, key=lambda x: x[0])
+    _, conv_shape, conv_dtype = sizes_sorted[0]
+    _, ssm_shape, ssm_dtype = sizes_sorted[-1]
+    return conv_shape, conv_dtype, ssm_shape, ssm_dtype
+
+
+def _c_contiguous_strides(shape: tuple[int, ...]) -> tuple[int, ...]:
+    strides: list[int] = [1]
+    for dim in reversed(shape[1:]):
+        strides.append(strides[-1] * int(dim))
+    return tuple(reversed(strides))
+
+
+@dataclass
+class HybridK8v4Views:
+    k_cache: torch.Tensor
+    v_cache: torch.Tensor
+    conv: torch.Tensor
+    ssm: torch.Tensor
+    num_physical_blocks: int
+    kernel_block_size: int
+    star_bytes: int
+
+
+def view_hybrid_k8v4_soa(
+    raw: torch.Tensor,
+    *,
+    num_blocks: int,
+    num_kv_heads: int,
+    head_size: int,
+    block_size: int,
+    conv_shape: tuple[int, ...],
+    conv_dtype: torch.dtype,
+    ssm_shape: tuple[int, ...],
+    ssm_dtype: torch.dtype,
+    kernel_block_size: int = KERNEL_BLOCK_SIZE,
+) -> HybridK8v4Views:
+    """910B SoA: ``conv | ★ | V`` with ★ = max(S, B×k).
+
+    Packed K is the prefix of each ★ row (full row at B≥B_fill). GDN S is
+    the same row with stride ★, first ``ssm_bytes`` — same physical slot.
+    K/V split into ``B / kernel_block_size`` kernel pages of 128 tokens.
+    ``num_blocks`` is the Manager N (padded pages), not ``raw // packed``.
+    """
+    conv_bytes = math.prod(conv_shape) * get_dtype_size(conv_dtype)
+    ssm_bytes = math.prod(ssm_shape) * get_dtype_size(ssm_dtype)
+    geo = compute_hybrid_k8v4_page(
+        conv_bytes=conv_bytes,
+        ssm_bytes=ssm_bytes,
+        num_kv_heads=num_kv_heads,
+        head_size=head_size,
+        block_size=block_size,
+    )
+    page = geo.page_bytes
+    raw_u8 = raw.view(torch.uint8).reshape(-1)
+    if raw_u8.numel() < num_blocks * page:
+        raise ValueError(
+            f"raw has {raw_u8.numel()} bytes, need {num_blocks} × {page}"
+        )
+    # Use Manager N; extra tail (if any) is unused.
+    n = num_blocks
+    buf = raw_u8[: n * page]
+    conv_band = n * geo.conv_bytes
+    star_band = n * geo.star_bytes
+    conv_u8 = buf[:conv_band]
+    star_u8 = buf[conv_band : conv_band + star_band]
+    v_u8 = buf[conv_band + star_band : conv_band + star_band + n * geo.v_band_bytes]
+
+    conv = conv_u8.view(conv_dtype).view(n, *conv_shape)
+
+    k_bytes = num_kv_heads * geo.key_packed_per_head
+    star_rows = star_u8.view(n, geo.star_bytes)
+    if k_bytes > geo.star_bytes:
+        raise ValueError(
+            f"packed K {k_bytes} exceeds star {geo.star_bytes}"
+        )
+    k_phys = star_rows[:, :k_bytes].reshape(
+        n, num_kv_heads, geo.key_packed_per_head
+    )
+    v_phys = v_u8.view(n, num_kv_heads, geo.value_packed_per_head)
+
+    ssm_elem = get_dtype_size(ssm_dtype)
+    if geo.star_bytes % ssm_elem != 0:
+        raise ValueError("star band is not aligned to ssm dtype")
+    star_elems = geo.star_bytes // ssm_elem
+    ssm = torch.as_strided(
+        star_u8.view(ssm_dtype),
+        size=(n, *ssm_shape),
+        stride=(star_elems, *_c_contiguous_strides(ssm_shape)),
+    )
+
+    chunks = block_size // kernel_block_size
+    pk_k = k8v4_key_packed_width(kernel_block_size, head_size)
+    pv_k = k8v4_value_packed_width(kernel_block_size, head_size)
+    k_cache = k_phys.view(n, chunks, num_kv_heads, pk_k).reshape(
+        n * chunks, num_kv_heads, pk_k
+    )
+    v_cache = v_phys.view(n, chunks, num_kv_heads, pv_k).reshape(
+        n * chunks, num_kv_heads, pv_k
+    )
+    return HybridK8v4Views(
+        k_cache=k_cache,
+        v_cache=v_cache,
+        conv=conv,
+        ssm=ssm,
+        num_physical_blocks=n,
+        kernel_block_size=kernel_block_size,
+        star_bytes=geo.star_bytes,
+    )
