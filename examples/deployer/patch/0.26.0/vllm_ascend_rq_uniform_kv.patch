diff --git a/vllm_ascend/ascend_config.py b/vllm_ascend/ascend_config.py
index 90b5beec5..46328c4f1 100644
--- a/vllm_ascend/ascend_config.py
+++ b/vllm_ascend/ascend_config.py
@@ -284,6 +284,28 @@ class AscendConfig:
                 )
 
         self.enable_sparse_sfa_c8 = additional_config.get("enable_sparse_sfa_c8", False) and use_sparse
+        # SFA rq_uniform fused 386-byte slots via npu_kv_quant_sparse_flash_attention
+        # (key_quant_mode=3). Enabled by --kv-cache-dtype turboquant_4bit_nc.
+        # SFA rq_uniform 4bit_uq 388-byte slots via jiuwen rq_uniform_* (mode=4):
+        # --kv-cache-dtype rq_4bit_uq (same name as Full-Attn K4V4;
+        # enable_sparse_sfa_4bit is only set when the model is SFA/sparse).
+        cache_dtype = getattr(getattr(vllm_config, "cache_config", None), "cache_dtype", None)
+        self.enable_sparse_sfa_rq_uniform = cache_dtype == "turboquant_4bit_nc" and use_sparse
+        self.enable_sparse_sfa_4bit = (
+            cache_dtype == "rq_4bit_uq" and use_sparse
+        )
+        if self.enable_sparse_sfa_rq_uniform and self.enable_sparse_sfa_c8:
+            raise ValueError(
+                "enable_sparse_sfa_c8 and turboquant_4bit_nc (SFA RqUniform) are mutually exclusive."
+            )
+        if self.enable_sparse_sfa_4bit and self.enable_sparse_sfa_c8:
+            raise ValueError(
+                "enable_sparse_sfa_c8 and rq_4bit_uq are mutually exclusive."
+            )
+        if self.enable_sparse_sfa_4bit and self.enable_sparse_sfa_rq_uniform:
+            raise ValueError(
+                "turboquant_4bit_nc and rq_4bit_uq are mutually exclusive."
+            )
         self.enable_sparse_li_c8 = additional_config.get("enable_sparse_li_c8", False) and use_sparse
         self.c8_enable_reshape_optim = self.enable_sparse_li_c8 and additional_config.get(
             "c8_enable_reshape_optim", False
diff --git a/vllm_ascend/attention/mla_rq_uniform_impl.py b/vllm_ascend/attention/mla_rq_uniform_impl.py
new file mode 100644
index 000000000..ebe4a041f
--- /dev/null
+++ b/vllm_ascend/attention/mla_rq_uniform_impl.py
@@ -0,0 +1,518 @@
+# Copyright (c) 2025-2026 The vllm-ascend Authors. All Rights Reserved.
+"""MLA RqUniform attention impl (P1–P3 hooks)."""
+
+from __future__ import annotations
+
+from typing import Any
+
+_IMPL_CLS: type[Any] | None = None
+
+
+def _build_impl_cls() -> type[Any]:
+    import torch
+    import torch_npu
+
+    # Nested class methods resolve bare names via this module's globals.
+    g = globals()
+    g["torch"] = torch
+    g["torch_npu"] = torch_npu
+
+    from vllm.logger import logger
+
+    from vllm_ascend.ascend_forward_context import _EXTRA_CTX
+    from vllm_ascend.attention.mla_v1 import AscendMLAImpl
+    from vllm_ascend.compilation.acl_graph import get_graph_params
+    from vllm_ascend.device.device_op import DeviceOperator
+    from vllm_ascend.ops.mla_rq_uniform_ops import (
+        mla_dequant_paged_latent,
+        mla_scheme_a_paged_decode,
+    )
+    from vllm_ascend.ops.rq_uniform_tables import latent_rotation_tables
+    from vllm_ascend.utils import AscendDeviceType, get_ascend_device_type, weak_ref_tensors
+
+    class _AscendMLARqUniformImpl(AscendMLAImpl):
+        """MLA impl with Scheme A RqUniform pack / absorb.
+
+        ACL FULL graph follows native ``AscendMLAImpl``:
+
+        * capture: wrap absorb in ``graph_task_group``, keep a stable out buffer
+        * update: zip ``attn_keys`` with handles and re-record with fresh host
+          ``seq_lens_list`` / ``actual_seq_lengths_q`` (same as FIA host lists)
+        * pack stays outside the updatable task group (same as native KV write)
+        """
+
+        tq_enabled: bool = True
+
+        def __init__(
+            self,
+            num_heads: int,
+            head_size: int,
+            scale: float,
+            num_kv_heads: int,
+            alibi_slopes: list[float] | None,
+            sliding_window: int | None,
+            kv_cache_dtype: str,
+            logits_soft_cap: float | None,
+            attn_type: str,
+            kv_sharing_target_layer_name: str | None,
+            **kwargs,
+        ):
+            from vllm.config import get_current_vllm_config
+
+            from vllm_ascend.attention.mla_rq_uniform_v1 import _SUPPORTED_PRESETS
+
+            # Boundary-skip layers may arrive as "auto"; use engine cache dtype.
+            resolved = kv_cache_dtype
+            if resolved == "auto" or resolved is None:
+                resolved = get_current_vllm_config().cache_config.cache_dtype
+            if resolved not in _SUPPORTED_PRESETS:
+                raise ValueError(
+                    f"Unsupported MLA RqUniform cache dtype on Ascend NPU: "
+                    f"{resolved!r}. Supported presets: "
+                    f"{', '.join(_SUPPORTED_PRESETS)}."
+                )
+            super().__init__(
+                num_heads,
+                head_size,
+                scale,
+                num_kv_heads,
+                alibi_slopes,
+                sliding_window,
+                resolved,
+                logits_soft_cap,
+                attn_type,
+                kv_sharing_target_layer_name,
+                **kwargs,
+            )
+
+        def _latent_rot(self, device, dtype):
+            return latent_rotation_tables(device, dtype, int(self.kv_lora_rank))
+
+        def _ensure_latent_cache(self, num_blocks, device):
+            stride = int(self.vllm_config.cache_config.block_size) * (int(self.kv_lora_rank) + 4)
+            packed = getattr(self, "_rq_uniform_latent_cache", None)
+            if (
+                packed is None
+                or packed.shape[0] != num_blocks
+                or packed.shape[1] != stride
+                or packed.device != device
+            ):
+                self._rq_uniform_latent_cache = torch.empty(
+                    num_blocks, stride, dtype=torch.uint8, device=device
+                )
+            return self._rq_uniform_latent_cache
+
+        def _pack_new_latent(self, kv_page, slots):
+            """Pack only the slots just written into the Scheme A page cache."""
+            if slots is None or slots.numel() == 0:
+                return
+            from vllm_ascend.ops.jiuwen_ops import jiuwen_op
+
+            block_size = int(self.vllm_config.cache_config.block_size)
+            rank = int(self.kv_lora_rank)
+            # Cache layout from AscendMLABackend.get_kv_cache_shape:
+            # [num_blocks, block_size, num_kv_heads, rank]
+            page = kv_page.view(-1, block_size, self.num_kv_heads, rank)
+            slots_i32 = slots.reshape(-1)
+            if slots_i32.dtype != torch.int32:
+                slots_i32 = slots_i32.to(torch.int32)
+            # Pack skips slot < 0. Clamp the gather index in place so a
+            # compacting mask does not sync back to the host.
+            safe = torch.clamp(slots_i32, min=0)
+            blk = torch.div(safe, block_size, rounding_mode="floor")
+            pos = torch.remainder(safe, block_size)
+            c = page[blk, pos, 0]
+            if not c.is_contiguous():
+                c = c.contiguous()
+            rot_t, _ = self._latent_rot(c.device, c.dtype)
+            packed = self._ensure_latent_cache(page.shape[0], c.device)
+            jiuwen_op("rq_uniform_pack_mla_latent")(
+                c, rot_t, slots_i32, packed, block_size
+            )
+
+        def exec_kv_prefill(self, kv_no_split, cos, sin, kv_cache, slots):
+            k_pe, k_nope = super().exec_kv_prefill(kv_no_split, cos, sin, kv_cache, slots)
+            self._pack_new_latent(kv_cache[0], slots)
+            return k_pe, k_nope
+
+        def exec_kv_decode(self, kv_no_split, cos, sin, kv_cache, slots):
+            k_pe, k_nope = super().exec_kv_decode(kv_no_split, cos, sin, kv_cache, slots)
+            self._pack_new_latent(kv_cache[0], slots)
+            return k_pe, k_nope
+
+        def _compute_prefill_context(
+            self,
+            q_nope: torch.Tensor,
+            q_pe: torch.Tensor,
+            kv_c_and_k_pe_cache: tuple[torch.Tensor],
+            rope_dim: int,
+            attn_metadata,
+            prefix_output: torch.Tensor,
+            prefix_lse: torch.Tensor,
+        ):
+            """Chunked-prefill history: dequant Scheme A cache → kv_b → FIA → LSE.
+
+            Matches upstream FA/LSE merge; only the history latent load is RQ.
+            """
+            assert len(kv_c_and_k_pe_cache) > 1
+            prefill_metadata = attn_metadata.prefill
+            if prefill_metadata is None or prefill_metadata.chunked_context is None:
+                return prefix_output, prefix_lse
+
+            iters = len(prefill_metadata.chunked_context.seq_tot)
+            cache_kv_c = kv_c_and_k_pe_cache[0]
+            cache_k_pe = kv_c_and_k_pe_cache[1]
+            num_heads = cache_k_pe.size(2)
+            latent_kv_dim = cache_kv_c.size(-1)
+            actual_seq_lengths_q = prefill_metadata.actual_seq_lengths_q
+            if iters == 0:
+                return prefix_output, prefix_lse
+
+            packed = getattr(self, "_rq_uniform_latent_cache", None)
+            if packed is None:
+                raise RuntimeError(
+                    "MLA RQ chunked prefill: packed latent cache missing before history dequant"
+                )
+
+            logger.info_once(
+                "MLA RQ chunked prefill: rq_uniform_dequant_mla_latent + kv_b_proj + FIA"
+            )
+
+            num_tokens = q_nope.size(0)
+            D = self.v_head_dim
+            H = self.num_heads
+            block_size = int(self.vllm_config.cache_config.block_size)
+            _, rot = self._latent_rot(q_nope.device, q_nope.dtype)
+
+            if prefix_lse.dim() == 2:
+                prefix_lse = prefix_lse.transpose(0, 1).unsqueeze(-1)
+            prefix_output = prefix_output.to(torch.float32)
+            prefix_lse = prefix_lse.to(torch.float32)
+            out_list = [prefix_output.reshape(num_tokens * H, D)]
+            lse_list = [prefix_lse.reshape(num_tokens * H)]
+
+            if self.head_padding > 0:
+                query = torch.cat((q_nope, q_pe), dim=-1)
+
+            common_kwargs = {
+                "num_heads": self.num_heads,
+                "num_key_value_heads": self.num_heads,
+                "input_layout": "TND",
+                "atten_mask": None,
+                "sparse_mode": 0,
+                "scale": self.scale,
+                "antiquant_mode": 0,
+                "antiquant_scale": None,
+                "softmax_lse_flag": True,
+                "actual_seq_lengths": actual_seq_lengths_q,
+            }
+
+            for i in range(iters):
+                toks = prefill_metadata.chunked_context.seq_tot[i]
+                context_seq_len_npu = self.get_context_seq_len_npu(i, attn_metadata)
+                kv_c_normed = torch.empty(
+                    toks, num_heads, latent_kv_dim, dtype=cache_kv_c.dtype, device=cache_kv_c.device
+                )
+                k_pe = torch.empty(
+                    toks, num_heads, rope_dim, dtype=q_pe.dtype, device=q_pe.device
+                )
+
+                # k_pe still lives in the fp rope page; latent comes from RQ codes.
+                DeviceOperator.kv_cache_load(
+                    cache_kv_c,
+                    cache_k_pe,
+                    prefill_metadata.block_table,
+                    context_seq_len_npu,
+                    prefill_metadata.chunked_context.starts[i],
+                    key=kv_c_normed,
+                    value=k_pe,
+                )
+                context_lens = context_seq_len_npu.to(dtype=torch.int32).reshape(-1)
+                seq_starts = (
+                    prefill_metadata.chunked_context.starts[i].to(dtype=torch.int32).reshape(-1)
+                )
+                c = mla_dequant_paged_latent(
+                    packed,
+                    rot,
+                    prefill_metadata.block_table,
+                    context_lens,
+                    seq_starts,
+                    block_size,
+                    toks,
+                )
+                kv_c_normed = c.view(toks, num_heads, latent_kv_dim).to(dtype=q_nope.dtype)
+                kv_c_normed, k_pe = self._reorg_kvcache(
+                    kv_c_normed,
+                    k_pe,
+                    chunked_context=prefill_metadata.chunked_context,
+                    chunk_idx=i,
+                    toks=toks,
+                )
+                kv_c_normed = kv_c_normed.squeeze()
+                if self.fa_quant_layer and get_ascend_device_type() == AscendDeviceType.A5:
+                    kv_c_normed = torch.mul(
+                        kv_c_normed.to(self.fak_descale_float.dtype), self.fak_descale_float
+                    ).to(torch.bfloat16)
+                kv_nope = self.kv_b_proj(kv_c_normed)[0].view(
+                    -1, self.num_heads, self.qk_nope_head_dim + self.v_head_dim
+                )
+                k_nope, v = kv_nope.split([self.qk_nope_head_dim, self.v_head_dim], dim=-1)
+                k_pe = k_pe.expand((*k_nope.shape[:-1], -1))
+
+                actual_seq_lengths_kv = (
+                    prefill_metadata.chunked_context.chunk_actual_seq_lengths_kv_list[i]
+                )
+                common_kwargs["actual_seq_lengths_kv"] = actual_seq_lengths_kv
+
+                if self.head_padding > 0:
+                    key = torch.cat((k_nope, k_pe), dim=-1)
+                else:
+                    common_kwargs["query_rope"] = q_pe
+                    common_kwargs["key_rope"] = k_pe.contiguous()
+                    query = q_nope
+                    key = k_nope
+
+                chunk_out, chunk_lse = torch_npu.npu_fused_infer_attention_score(
+                    query, key.contiguous(), v.contiguous(), **common_kwargs
+                )
+
+                if chunk_lse.dim() == 2:
+                    chunk_lse = chunk_lse.transpose(0, 1).unsqueeze(-1)
+                chunk_out = chunk_out.to(torch.float32)
+                chunk_lse = chunk_lse.to(torch.float32)
+                out_list.append(chunk_out.reshape(num_tokens * H, D))
+                lse_list.append(chunk_lse.reshape(num_tokens * H))
+
+            output_final, _ = torch_npu.npu_attention_update(tuple(lse_list), tuple(out_list), 0)
+            return output_final.view(num_tokens, H, D), None
+
+        def _forward_decode(
+            self,
+            q_nope,
+            q_pe,
+            k_nope,
+            k_pe,
+            block_size,
+            attn_metadata,
+            dequant_scale_q_nope=None,
+        ):
+            decode_meta = attn_metadata.decode
+            seq_lens_list = list(decode_meta.seq_lens_list) if decode_meta is not None else []
+            # One query token per request, latent already absorbed to kv_lora_rank.
+            if not (
+                dequant_scale_q_nope is None
+                and q_nope.dim() == 3
+                and q_nope.shape[-1] == self.kv_lora_rank
+                and q_nope.shape[0] == len(seq_lens_list)
+                and q_pe.shape[0] == len(seq_lens_list)
+            ):
+                return super()._forward_decode(
+                    q_nope,
+                    q_pe,
+                    k_nope,
+                    k_pe,
+                    block_size,
+                    attn_metadata,
+                    dequant_scale_q_nope,
+                )
+
+            logger.info_once(
+                "MLA RQ decode: packed latent cache + rq_uniform_fia_mla_latent_paged"
+            )
+            packed = getattr(self, "_rq_uniform_latent_cache", None)
+            if packed is None:
+                raise RuntimeError("MLA RQ latent cache was not packed before decode")
+            rot_t, rot = self._latent_rot(q_nope.device, q_nope.dtype)
+            actual_seq_lengths = getattr(decode_meta, "actual_seq_lengths_q", None)
+            num_tokens = q_nope.size(0)
+            block_table = decode_meta.block_table
+
+            # Mirror AscendMLAImpl._forward_decode ACL-graph capture path:
+            # stable out + graph_task_group; host lists refreshed in update.
+            if _EXTRA_CTX.capturing:
+                graph_params = get_graph_params()
+                stream = torch_npu.npu.current_stream()
+
+                event = torch.npu.ExternalEvent()
+                event.wait(stream)
+                event.reset(stream)
+                graph_params.events[num_tokens].append(event)
+
+                # Absorb returns latent context [H, B, L] for W_UV.
+                attn_output = torch.empty(
+                    self.num_heads,
+                    num_tokens,
+                    int(self.kv_lora_rank),
+                    dtype=q_nope.dtype,
+                    device=q_nope.device,
+                )
+                # Same layout spirit as native MLA attn_params (per-layer tuple).
+                graph_params.attn_params[num_tokens].append(
+                    (
+                        weak_ref_tensors(q_nope),
+                        weak_ref_tensors(q_pe),
+                        weak_ref_tensors(packed),
+                        weak_ref_tensors(k_pe),
+                        block_table,
+                        int(block_size),
+                        seq_lens_list,
+                        actual_seq_lengths,
+                        weak_ref_tensors(rot),
+                        weak_ref_tensors(rot_t),
+                        float(self.scale),
+                        int(self.num_kv_heads),
+                        int(self.kv_lora_rank),
+                        int(self.qk_rope_head_dim),
+                        weak_ref_tensors(attn_output),
+                    )
+                )
+
+                torch.npu.graph_task_group_begin(stream)
+                mla_scheme_a_paged_decode(
+                    q_nope,
+                    q_pe,
+                    packed,
+                    k_pe,
+                    block_table,
+                    seq_lens_list,
+                    int(block_size),
+                    float(self.scale),
+                    rot,
+                    rot_t,
+                    int(self.num_kv_heads),
+                    int(self.kv_lora_rank),
+                    int(self.qk_rope_head_dim),
+                    actual_seq_lengths_q=actual_seq_lengths,
+                    out=attn_output,
+                )
+                handle = torch.npu.graph_task_group_end(stream)
+                graph_params.handles[num_tokens].append(handle)
+                return self._v_up_proj(attn_output)
+
+            ctx = mla_scheme_a_paged_decode(
+                q_nope,
+                q_pe,
+                packed,
+                k_pe,
+                block_table,
+                seq_lens_list,
+                int(block_size),
+                float(self.scale),
+                rot,
+                rot_t,
+                int(self.num_kv_heads),
+                int(self.kv_lora_rank),
+                int(self.qk_rope_head_dim),
+                actual_seq_lengths_q=actual_seq_lengths,
+            )
+            return self._v_up_proj(ctx)
+
+        @staticmethod
+        def update_graph_params(
+            update_stream,
+            forward_context,
+            num_tokens,
+            vllm_config=None,
+            speculative_config=None,
+            num_dcp_pcp_tokens=None,
+            draft_attn_metadatas=None,
+        ):
+            """Refresh absorb launches — same zip(attn_keys) pattern as native MLA."""
+            del vllm_config, num_dcp_pcp_tokens, draft_attn_metadatas
+            if _EXTRA_CTX.is_draft_model:
+                raise NotImplementedError(
+                    "MLA RQ update_graph_params does not support speculative draft yet"
+                )
+
+            graph_params = get_graph_params()
+            attn_metadata = forward_context.attn_metadata
+            if not attn_metadata:
+                return
+            attn_keys = list(attn_metadata.keys())
+            num_layers = len(attn_keys)
+            if num_layers == 0:
+                return
+            captured = graph_params.attn_params.get(num_tokens) or []
+            handles = graph_params.handles.get(num_tokens) or []
+            events = graph_params.events.get(num_tokens) or []
+            if not captured:
+                return
+
+            with torch.npu.stream(update_stream):
+                for key, param, handle, event in zip(
+                    attn_keys, captured, handles, events
+                ):
+                    (
+                        q_nope,
+                        q_pe,
+                        packed,
+                        k_pe,
+                        block_table,
+                        block_size,
+                        _seq_lens_list,
+                        _actual_seq_lengths,
+                        rot,
+                        rot_t,
+                        scale,
+                        num_kv_heads,
+                        kv_lora_rank,
+                        rope_dim,
+                        attn_output,
+                    ) = param
+
+                    # Native MLA: re-read host lists from this layer's decode meta.
+                    seq_lens_list = list(attn_metadata[key].decode.seq_lens_list)
+                    actual_seq_lengths = attn_metadata[key].decode.actual_seq_lengths_q
+                    if speculative_config and speculative_config.use_eagle():
+                        actual_seq_lengths = attn_metadata[key].decode.actual_seq_lengths_q
+                        spec_multiple = speculative_config.num_speculative_tokens + 1
+                        seq_lens_list = seq_lens_list + [0] * (
+                            num_tokens // spec_multiple - len(seq_lens_list)
+                        )
+                        actual_seq_lengths = [
+                            spec_multiple * (i + 1) for i in range(num_tokens // spec_multiple)
+                        ]
+                    else:
+                        # Pad with zeros to the captured graph batch (native MLA).
+                        seq_lens_list = seq_lens_list + [0] * (
+                            num_tokens - len(seq_lens_list)
+                        )
+
+                    torch.npu.graph_task_update_begin(update_stream, handle)
+                    # Host int[] rebound like native FIA actual_seq_qlen/kvlen.
+                    mla_scheme_a_paged_decode(
+                        q_nope,
+                        q_pe,
+                        packed,
+                        k_pe,
+                        block_table,
+                        seq_lens_list,
+                        int(block_size),
+                        float(scale),
+                        rot,
+                        rot_t,
+                        int(num_kv_heads),
+                        int(kv_lora_rank),
+                        int(rope_dim),
+                        actual_seq_lengths_q=actual_seq_lengths,
+                        out=attn_output,
+                    )
+                    torch.npu.graph_task_update_end(update_stream)
+                    event.record(update_stream)
+
+    _AscendMLARqUniformImpl.__name__ = "AscendMLARqUniformImpl"
+    _AscendMLARqUniformImpl.__qualname__ = "AscendMLARqUniformImpl"
+    return _AscendMLARqUniformImpl
+
+
+class AscendMLARqUniformImpl:
+    """Lightweight stub for routing; use :meth:`build` for the real subclass."""
+
+    tq_enabled: bool = True
+
+    @classmethod
+    def build(cls) -> type:
+        global _IMPL_CLS
+        if _IMPL_CLS is None:
+            _IMPL_CLS = _build_impl_cls()
+        return _IMPL_CLS
