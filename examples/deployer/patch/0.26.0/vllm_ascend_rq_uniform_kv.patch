+def rq_uniform_kv_rmsnorm_rope_pack(
+    kv: torch.Tensor,
+    gamma: torch.Tensor,
+    cos: torch.Tensor,
+    sin: torch.Tensor,
+    kv_lora_rank: int,
+    qk_rope_head_dim: int,
+    *,
+    kv_cache: tuple,
+    slots: torch.Tensor,
+    block_size: int,
+    epsilon: float = 1e-5,
+) -> tuple[None, None, None]:
+    """rq_uniform 4bit_uq write: RMSNorm+RoPE then pack V2 into PA 388."""
+    rms_in, rope_in = kv.split([kv_lora_rank, qk_rope_head_dim], dim=-1)
+    k_nope, _ = torch_npu.npu_rms_norm(
+        rms_in.reshape(-1, kv_lora_rank), gamma, epsilon=epsilon
+    )
+    k_rope = torch_npu.npu_interleave_rope(rope_in, cos, sin).reshape(-1, qk_rope_head_dim)
+    main_cache = kv_cache[0]
+    if main_cache.dtype != torch.uint8:
+        main_cache = main_cache.view(torch.uint8)
+    assert main_cache.shape[-1] == RQ_UNIFORM_4BIT_UQ_SLOT_BYTES, (
+        f"rq_uniform 4bit_uq pack expects cache last dim {RQ_UNIFORM_4BIT_UQ_SLOT_BYTES}, got {tuple(main_cache.shape)}"
+    )
+    pack_op = jiuwen_op("rq_uniform_pack_sfa")
+    slot_i64 = slots.to(torch.int64).contiguous().view(-1)
+    pack_op(
+        k_nope.contiguous(),
+        k_rope.contiguous(),
+        slot_i64,
+        main_cache,
+        int(block_size),
+    )
+    return None, None, None
+
+
+def rq_uniform_kv_rmsnorm_rope(
+    kv: torch.Tensor,
+    gamma: torch.Tensor,
+    cos: torch.Tensor,
+    sin: torch.Tensor,
+    kv_lora_rank: int,
+    qk_rope_head_dim: int,
+    *,
+    rq_uniform_latent: RqUniformLatent,
+    epsilon: float = 1e-5,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """RqUniform counterpart of custom_kv_rmsnorm_rope (386-byte fused slots)."""
+    from vllm_ascend.attention.utils import get_rq_uniform_packed_bytes
+
+    rms_in, rope_in = kv.split([kv_lora_rank, qk_rope_head_dim], dim=-1)
+    k_nope, _ = torch_npu.npu_rms_norm(rms_in.reshape(-1, kv_lora_rank), gamma, epsilon=epsilon)
+    k_rope = torch_npu.npu_interleave_rope(rope_in, cos, sin).reshape(-1, qk_rope_head_dim)
+
+    packed_bytes = get_rq_uniform_packed_bytes(kv_lora_rank)
+    row = rq_uniform_latent.compress(k_nope).reshape(k_nope.shape[0], -1)
+    nibbles = row[:, :packed_bytes].view(torch.int8)
+    scale = row[:, packed_bytes:].contiguous().view(torch.float16).reshape(-1, 1)
+
+    # Pre-divide rope by s_t so attention rescales the whole slot with one multiply.
+    k_rope = (k_rope.float() / (scale.float() + 1e-20)).to(torch.bfloat16).contiguous()
+    return (
+        k_rope.view(torch.int8),
+        nibbles,
+        scale.contiguous().view(torch.int8),
+    )
+
