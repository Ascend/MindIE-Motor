+
+# Stand-in always present in upstream CacheDType Literal.
+_UPSTREAM_CACHE_DTYPE_STANDIN = "turboquant_k8v4"
+
+_RQ_UNIFORM_PRESET_STUBS: dict[str, dict] = {
+    "rq_k8v4_uq": {
+        "key_quant_bits": 8,
+        "value_quant_bits": 4,
+        "norm_correction": False,
+    },
+    "rq_4bit_uq": {
+        "key_quant_bits": 4,
+        "value_quant_bits": 4,
+        "norm_correction": False,
+    },
+    "rq_8bit_uq": {
+        "key_quant_bits": 8,
+        "value_quant_bits": 8,
+        "norm_correction": False,
+    },
