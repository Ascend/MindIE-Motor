diff --git a/vllm_ascend/ops/jiuwen_ops.py b/vllm_ascend/ops/jiuwen_ops.py
new file mode 100644
index 000000000..e0e2ff765
--- /dev/null
+++ b/vllm_ascend/ops/jiuwen_ops.py
@@ -0,0 +1,159 @@
+# Copyright (c) 2025-2026 The vllm-ascend Authors. All Rights Reserved.
+#
+# This code is based on the vllm-ascend project (https://github.com/vllm-project/vllm-ascend).
+"""Bridge to AscendC operators from the agent-tools openjiuwen package.
+
+Install the wheel ``openjiuwentools-openjiuwen-ascend-ops`` (or
+``pip install -e`` after ``csrc/build.sh``). This module only checks whether
+``openjiuwentools.openjiuwen_ascend_ops`` can be imported; OPP / ``libcust_*``
+wiring is owned entirely by that package's ``__init__``. Call sites must not
+require a shell-exported ``ASCEND_CUSTOM_OPP_PATH`` for jiuwen ops.
+"""
+
+from __future__ import annotations
+
+import logging
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+# Ops provided by openjiuwen_ascend_ops that this backend uses.
+JIUWEN_OP_NAMES = (
+    # RqUniform family (k8v4 / k4v4 pack + fused-infer-attention + MSD decode).
+    "rq_uniform_pack_k8v4",
+    "rq_uniform_pack_k4v4",
+    "rq_uniform_fia_paged_k8v4",
+    "rq_uniform_fia_paged_k4v4",
+    "rq_uniform_fia_paged_k8v4_msd",
+    "rq_uniform_fia_paged_k4v4_msd",
+    # MLA latent RQ (Scheme A pack / paged absorb / chunked dequant).
+    "rq_uniform_pack_mla_latent",
+    "rq_uniform_fia_mla_latent_paged",
+    "rq_uniform_dequant_mla_latent",
+    # SFA rq_uniform 4bit_uq (388B fused PA). Pack defaults to V2 (tilingKey=1,
+    # signed int4). Attention V2 dequants that layout.
+    "rq_uniform_pack_sfa",
+    "rq_uniform_kv_quant_sparse_flash_attention_v2",
+)
+
+_jiuwen_imported: bool | None = None
+_jiuwen_warned = False
+_op_handle_cache: dict[str, object] = {}
+
+_OPS_PACKAGE = "openjiuwentools.openjiuwen_ascend_ops"
+_OPS_NAMESPACE = "openjiuwen"
+
+
+def _preload_opapi_global() -> None:
+    """Load libcust_opapi_jw.so from the installed package (RTLD_GLOBAL).
+
+    openjiuwen ships a unique SONAME (``libcust_opapi_jw.so``) so ``dlopen``
+    does not collide with vllm-ascend / custom_transformer ``libcust_opapi.so``.
+    """
+    import os
+
+    import ctypes
+
+    _JW_OPAPI = "libcust_opapi_jw.so"
+    try:
+        import openjiuwentools.openjiuwen_ascend_ops as _pkg
+    except Exception:
+        return
+    path = os.path.join(os.path.dirname(_pkg.__file__), _JW_OPAPI)
+    if not os.path.isfile(path):
+        logger.warning(
+            "%s missing next to installed package; rebuild/reinstall "
+            "openjiuwentools-openjiuwen-ascend-ops",
+            _JW_OPAPI,
+        )
+        return
+    try:
+        ctypes.CDLL(path, mode=ctypes.RTLD_GLOBAL)
+        logger.debug("Preloaded %s with RTLD_GLOBAL", path)
+    except OSError as exc:
+        logger.warning("Failed to preload %s: %s", path, exc)
+
+
+def _try_import_jiuwen() -> bool:
+    """Import the openjiuwen operator package once and cache the result.
+
+    Never raises: a missing wheel must not take the process down at import
+    time — callers get a clear error when they actually resolve an op.
+    """
+    global _jiuwen_imported, _jiuwen_warned
+    if _jiuwen_imported is None:
+        try:
+            # Package __init__ registers torch.ops.openjiuwen.* and injects
+            # package-local OPP / LD_LIBRARY_PATH (idempotent).
+            import openjiuwentools.openjiuwen_ascend_ops  # type: ignore  # noqa: F401
+
+            _jiuwen_imported = True
+            _preload_opapi_global()
+        except Exception as exc:  # pragma: no cover - environment dependent
+            _jiuwen_imported = False
+            if not _jiuwen_warned:
+                _jiuwen_warned = True
+                logger.warning(
+                    "%s unavailable (%s); RqUniform custom ops will not "
+                    "resolve. Install the openjiuwentools-openjiuwen-ascend-ops "
+                    "wheel (pip install after csrc/build.sh).",
+                    _OPS_PACKAGE,
+                    exc,
+                )
+    return _jiuwen_imported
+
+
+def ensure_jiuwen_ops(*, required: bool = False) -> bool:
+    """Eagerly import openjiuwen so OPP env is injected before CANN freezes it.
+
+    Call from platform config when an Ascend RqUniform / TurboQuant KV dtype
+    is selected (once for all backends: Full-Attn, SFA, MLA). Multiproc
+    workers then inherit ``ASCEND_CUSTOM_OPP_PATH`` at process start.
+
+    Args:
+        required: If True, raise when the wheel cannot be imported.
+    """
+    ok = _try_import_jiuwen()
+    if required and not ok:
+        raise RuntimeError(
+            f"{_OPS_PACKAGE} is required for Ascend RqUniform/TurboQuant KV "
+            "cache dtypes; install openjiuwentools-openjiuwen-ascend-ops "
+            "(pip install after csrc/build.sh)."
+        )
+    return ok
+
+
+def jiuwen_op_available(op_name: str) -> bool:
+    """True when ``op_name`` resolves under ``torch.ops.openjiuwen``."""
+    return _resolve(op_name) is not None
+
+
+def jiuwen_op(op_name: str):
+    """Resolve an openjiuwen custom op handle (cached after first resolution).
+
+    Raises:
+        RuntimeError: the wheel is missing or the op is not registered.
+    """
+    op = _resolve(op_name)
+    if op is None:
+        raise RuntimeError(
+            f"custom op torch.ops.{_OPS_NAMESPACE}.{op_name} is not available; "
+            f"install and import the openjiuwentools-openjiuwen-ascend-ops "
+            f"wheel (torch.ops.{_OPS_NAMESPACE} namespace)"
+        )
+    return op
+
+
+def _resolve(op_name: str):
+    cached = _op_handle_cache.get(op_name)
+    if cached is not None:
+        return cached
+    if not _try_import_jiuwen():
+        return None
+    lib = getattr(torch.ops, _OPS_NAMESPACE, None)
+    if lib is not None and hasattr(lib, op_name):
+        op = getattr(lib, op_name)
+        _op_handle_cache[op_name] = op
+        return op
+    return None
