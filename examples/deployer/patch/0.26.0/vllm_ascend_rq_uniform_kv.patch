+def get_rq_uniform_packed_bytes(kv_lora_rank: int) -> int:
+    """Bytes of the int4-packed nope half of one rq_uniform 4-bit latent slot."""
+    return kv_lora_rank // 2
+
+
+def get_rq_uniform_fused_slot_bytes(kv_lora_rank: int, qk_rope_head_dim: int) -> int:
+    """Bytes of one fused rq_uniform 4-bit slot: int4 nope + bf16 rope + fp16 scale.
+
+    For DeepSeek-V3.2 (kv_lora_rank=512, qk_rope_head_dim=64) this is 386.
+    """
+    return (
+        get_rq_uniform_packed_bytes(kv_lora_rank)
+        + qk_rope_head_dim * get_dtype_size(torch.bfloat16)
+        + get_dtype_size(torch.float16)
+    )
+
+
+def get_rq_uniform_4bit_uq_fused_slot_bytes(kv_lora_rank: int, qk_rope_head_dim: int) -> int:
+    """Bytes of one rq_uniform 4bit_uq slot: int4 nope + bf16/fp16 rope + fp16 scale+offset.
+
+    For DeepSeek-V3.2 (kv_lora_rank=512, qk_rope_head_dim=64) this is 388
+    (= 256 + 128 + 4). Dequant: y = offset + uint4(code) * scale.
+    """
+    return (
+        get_rq_uniform_packed_bytes(kv_lora_rank)
+        + qk_rope_head_dim * get_dtype_size(torch.bfloat16)
+        + 2 * get_dtype_size(torch.float16)
+    )
+
