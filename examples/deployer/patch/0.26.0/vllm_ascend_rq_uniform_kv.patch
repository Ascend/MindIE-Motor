+def _is_hybrid_strided_state(state: torch.Tensor) -> bool:
+    """True when ``state`` rows are wider than the logical inner dims.
+
+    The hybrid k8v4 page views the GDN SSM band with ``as_strided``:
+    ``stride(0) = star_elems >= prod(inner)``. A plain contiguous mamba
+    cache has ``stride(0) == prod(inner)``.
