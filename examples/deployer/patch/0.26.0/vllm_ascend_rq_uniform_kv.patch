+    """True for Ascend RqUniform / upstream TurboQuant KV cache dtype strings.
+
+    Matches Ascend-only ``rq_*_uq`` names and upstream ``turboquant_*``
+    presets (e.g. SFA ``turboquant_4bit_nc``).
+    """
+    if not dtype:
+        return False
+    return dtype in _ASCEND_RQ_UNIFORM_SET or dtype.startswith("turboquant_")
