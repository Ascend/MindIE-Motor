+# Copyright (c) 2025-2026 The vllm-ascend Authors. All Rights Reserved.
+"""Ascend MLA × RqUniform attention backend (P0+ scaffolding).
+
+P0: platform routes ``use_mla + rq_8bit_uq`` here instead of Full RQ.
+Scheme A pack / absorb live in ``ops.mla_rq_uniform_ops`` and ``mla_rq_uniform_impl``;
+this module wires the MLA backend surface.
+
+``mla_v1`` is imported lazily. Importing it while this module loads pulls
+``device_op`` through ``ops`` and cycles.
+"""
+
+from __future__ import annotations
+
+# MLA latent Scheme A — only this Ascend RQ preset is valid for this backend.
+_PRESET_MLA_LATENT_8BIT = "rq_8bit_uq"
+_SUPPORTED_PRESETS = (_PRESET_MLA_LATENT_8BIT,)
+
+
+def _mla_backend():
+    from vllm_ascend.attention.mla_v1 import AscendMLABackend
+
+    return AscendMLABackend
+
+
+class _LazyMLAAttrs(type):
+    """Forward MLA backend APIs that this class does not override."""
+
+    def __getattr__(cls, name: str):
+        return getattr(_mla_backend(), name)
+
+
+class AscendMLARqUniformBackend(metaclass=_LazyMLAAttrs):
+    """MLA attention backend with RqUniform latent cache (design P0–P3)."""
+
+    accept_output_buffer: bool = True
+    supported_kv_cache_dtypes = list(_SUPPORTED_PRESETS)
+
+    @staticmethod
+    def get_name() -> str:
+        return "ASCEND_MLA_RQ_UNIFORM"
+
+    @classmethod
+    def get_required_kv_cache_layout(cls):
+        return None
+
+    @classmethod
+    def supports_kv_cache_dtype(cls, kv_cache_dtype) -> bool:
+        return kv_cache_dtype in _SUPPORTED_PRESETS
+
+    @staticmethod
+    def get_impl_cls():
+        from vllm_ascend.attention.mla_rq_uniform_impl import AscendMLARqUniformImpl
+
+        # Prefer the concrete MLA subclass when the full worker graph can load;
+        # fall back to the lightweight stub for routing / import-only callers.
+        try:
+            return AscendMLARqUniformImpl.build()
+        except ImportError:
+            return AscendMLARqUniformImpl
+
+    @classmethod
+    def full_cls_name(cls) -> tuple[str, str]:
+        return (cls.__module__, cls.__qualname__)
+
+
+__all__ = ["AscendMLARqUniformBackend", "_SUPPORTED_PRESETS"]
diff --git a/vllm_ascend/attention/rq_uniform_v1.py b/vllm_ascend/attention/rq_uniform_v1.py
