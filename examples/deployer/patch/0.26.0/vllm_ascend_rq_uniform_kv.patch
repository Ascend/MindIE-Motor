+def _run_recurrent_gated_delta_rule(
+    *,
+    ssm_state: torch.Tensor,
+    ssm_state_indices: torch.Tensor,
+    **op_kwargs,
+) -> torch.Tensor:
+    """``npu_recurrent_gated_delta_rule`` safe for hybrid as_strided states.
+
+    The AscendC op indexes the state cache by ``ssm_state_indices`` assuming
+    a plain cache layout; on a hybrid-k8v4 ``as_strided`` view that
+    addressing lands at wrong page offsets (garbage decode / lost state
+    writes). For strided states: gather the live rows into a compact buffer,
+    run the op with identity indices, and scatter the updated rows back
+    through the view. Contiguous caches take the original zero-copy path.
+    """
+    if not _is_hybrid_strided_state(ssm_state):
+        return torch.ops._C_ascend.npu_recurrent_gated_delta_rule(
+            state=ssm_state, ssm_state_indices=ssm_state_indices, **op_kwargs
+        )
+    # ACL-graph-safe gather/scatter: NO boolean-mask indexing —
+    # ``tensor[bool_mask]`` lowers to nonzero() (dynamic shape + stream sync),
+    # which is illegal during graph capture ("stream is captured" on
+    # aclnnNonzeroV2). Clamp pad indices to 0 instead: block 0 is the
+    # NULL/pad block (kernels skip state_idx <= 0), so writing the pad rows
+    # back there is harmless. Integer advanced indexing / where / arange are
+    # all static-shape and capturable.
+    idx_safe = torch.where(
+        ssm_state_indices >= 0,
+        ssm_state_indices,
+        torch.zeros_like(ssm_state_indices),
+    )
+    gathered = torch.index_select(ssm_state, 0, idx_safe).contiguous()
+    identity = torch.arange(
+        gathered.shape[0], device=gathered.device, dtype=ssm_state_indices.dtype
+    )
+    out = torch.ops._C_ascend.npu_recurrent_gated_delta_rule(
+        state=gathered, ssm_state_indices=identity, **op_kwargs
+    )
+    ssm_state[idx_safe] = gathered.to(ssm_state.dtype)
+    return out
+
