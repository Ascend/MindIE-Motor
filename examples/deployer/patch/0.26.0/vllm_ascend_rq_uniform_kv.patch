index 000000000..20bb415f1
--- /dev/null
+++ b/vllm_ascend/attention/rq_uniform_v1.py
@@ -0,0 +1,986 @@
+#
+# Copyright (c) 2025-2026 The vllm-ascend Authors. All Rights Reserved.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+# This file is a part of the vllm-ascend project.
+#
+"""Ascend RqUniform attention backend.
+
+Implements the vLLM ``--kv-cache-dtype rq_uniform_*`` presets on Ascend NPUs
+by delegating the compressed-KV storage and attention to the custom AscendC
+operators from the agent-tools openjiuwen package (``torch.ops.openjiuwen.*``).
+
+Preset mapping (interface follows vLLM; quantization semantics are the
+Ascend variants implemented by the operators):
+
+* ``rq_k8v4_uq``   — RqUniform K8V4: Haar-rotated keys stored as 8-bit
+  uniform codes (Scheme A) + 4-bit values. Pack via
+  ``rq_uniform_pack_k8v4``; attention via ``rq_uniform_fia_paged_k8v4``
+  (prefill/continuation) or decode via ``rq_uniform_fia_paged_k8v4_msd``
+  (A2/A3) / ``rq_uniform_fia_paged_k8v4`` (A5; MSD unsupported).
+* ``rq_4bit_uq``   — RqUniform K4V4: Haar-rotated K/V both stored as
+  4-bit codes. Pack via ``rq_uniform_pack_k4v4``; attention via
+  ``rq_uniform_fia_paged_k4v4`` (prefill/continuation) or decode via
+  ``rq_uniform_fia_paged_k4v4_msd`` (A2/A3) / ``rq_uniform_fia_paged_k4v4``
+  (A5).
+* ``turboquant_4bit_nc`` / ``turboquant_k3v4_nc`` / ``turboquant_3bit_nc`` —
+  not supported on Ascend (no matching operator).
+
+Cache layout: the K and V slabs have different packed widths, so the spec
+carries the per-head slab strides as ``head_size``/``head_size_v`` (bytes)
+and the model runner splits the raw storage proportionally, producing
+``key_cache: (num_blocks, num_kv_heads, key_stride)`` and
+``value_cache: (num_blocks, num_kv_heads, value_stride)`` uint8 tensors —
+exactly the layouts the operators expect.
+
+First-chunk prefill (``PrefillNoCache``) runs full-precision attention over
+the freshly computed K/V through ``npu_fused_infer_attention_score`` (no
+quantization error on the first pass); all later steps read the packed
+cache. KV cache update (quantize + pack) happens inside ``forward``.
+
+ACL graph: decode steps captured by the FULL-mode ACL graph are replayed
+with per-step sequence lengths refreshed through the graph task-group
+handle mechanism (see ``update_graph_params``), mirroring the upstream
+paged-attention graph path. The pack op needs no handle update — for a
+decode graph every request contributes exactly one token, so its
+``query_start_loc`` (``[1, 2, ..., num_reqs]``) is constant per graph.
+"""
+
+from __future__ import annotations
+
+import logging
+from typing import TYPE_CHECKING
+
+import torch
+import torch_npu
+from vllm.config import get_current_vllm_config
+from vllm.v1.attention.backend import (
+    AttentionBackend,
+    AttentionImpl,
+    AttentionLayer,
+    AttentionMetadataBuilder,
+    AttentionType,
+)
+
+if TYPE_CHECKING:
+    from vllm.v1.kv_cache_interface import TQFullAttentionSpec
+
+from vllm_ascend.ascend_forward_context import _EXTRA_CTX
+from vllm_ascend.attention.attention_v1 import (
+    AscendAttentionMetadataBuilder,
+    AscendAttentionState,
+    AscendMetadata,
+    SWA_INT_MAX,
+)
+from vllm_ascend.compilation.acl_graph import get_graph_params
+from vllm_ascend.ops.jiuwen_ops import jiuwen_op
+from vllm_ascend.ops.rq_uniform_tables import (
+    RQ_UNIFORM_K8V4_SUB_BLOCK_ROWS,
+    rq_uniform_k8v4_head_size_ok,
+    rq_uniform_rotation_tables,
+    k8v4_key_block_stride,
+    k8v4_value_block_stride,
+)
+from vllm_ascend.utils import AscendDeviceType, get_ascend_device_type, weak_ref_tensors
+
+logger = logging.getLogger(__name__)
+
+
+def _fia_decode_op_name(suffix: str) -> str:
+    """Decode FIA op: MSD on A2/A3 only; A5 uses the base paged FIA kernel."""
+    if get_ascend_device_type() == AscendDeviceType.A5:
+        return f"rq_uniform_fia_paged_{suffix}"
+    return f"rq_uniform_fia_paged_{suffix}_msd"
+
+# RqUniform k8v4 supports D=128 and D=256 (Qwen3.6-class models); the k4v4
+# operator family remains D=128-only.
+_TQ_HEAD_SIZES = (128, 256)
+_TQ_K4V4_HEAD_SIZE = 128
+
+# Presets routed to the RqUniform K8V4 operator family.
+_PRESET_RQ_UNIFORM_K8V4 = "rq_k8v4_uq"
+# Preset routed to the RqUniform K4V4 operator family (K/V both int4).
+_PRESET_RQ_UNIFORM_K4V4 = "rq_4bit_uq"
+_SUPPORTED_PRESETS = (_PRESET_RQ_UNIFORM_K8V4, _PRESET_RQ_UNIFORM_K4V4)
+
+
+def _patch_core_rq_uniform_slot_geometry() -> None:
+    """Make core's hybrid page alignment use the Ascend k8v4 slot geometry.
+
+    Core ``_align_hybrid_block_size`` recomputes the RQ page from
+    ``RqUniformConfig.from_cache_dtype(...).slot_size_aligned`` — the CUDA
+    packed-slot size (134 B/token/head for k8v4). The Ascend operators use
+    16-row SoA tiles (200 B/token/head at D=128, 316 at D=256); aligning the
+    hybrid (attention + mamba) page against the wrong size breaks block
+    pooling. Wrap ``from_cache_dtype`` so ``slot_size_aligned`` reports the
+    Ascend per-token-per-head footprint for the presets this backend serves.
+    """
+    try:
+        from vllm.model_executor.layers.quantization.rq_uniform.config import (
+            RqUniformConfig,
+        )
+    except Exception:  # pragma: no cover - core layout change
+        return
+    if getattr(RqUniformConfig, "_ascend_slot_patch", False):
+        return
+    # Py3.10+: class-level access to a staticmethod yields the plain
+    # function already (no __func__ indirection).
+    orig_from_cache_dtype = RqUniformConfig.from_cache_dtype
+
+    def from_cache_dtype_ascend(cache_dtype: str, head_dim: int):
+        cfg = orig_from_cache_dtype(cache_dtype, head_dim)
+        if cache_dtype in _SUPPORTED_PRESETS:
+            try:
+                _, _, slot_bytes = ascend_rq_uniform_cache_strides(
+                    cache_dtype, block_size=16, head_size=head_dim
+                )
+                cfg.slot_size_aligned = slot_bytes
+            except ValueError:
+                pass
+        return cfg
+
+    RqUniformConfig.from_cache_dtype = staticmethod(from_cache_dtype_ascend)  # type: ignore[assignment]
+    RqUniformConfig._ascend_slot_patch = True  # type: ignore[attr-defined]
+
+
+_patch_core_rq_uniform_slot_geometry()
+
+
+def ascend_rq_uniform_cache_strides(
+    cache_dtype: str, block_size: int, head_size: int = 128
+) -> tuple[int, int, int]:
+    """Per-head cache slab strides (bytes) for a RqUniform preset.
+
+    Returns ``(key_stride, value_stride, slot_bytes)`` where ``slot_bytes``
+    is the per-token-per-head cache footprint used for page-size accounting
+    (``TQFullAttentionSpec.tq_slot_size``). The k8v4 layout is parametric in
+    head_size: 16*(D+4) key / 16*(D/2+4) value bytes per 16-row group.
+    """
+    if cache_dtype in (_PRESET_RQ_UNIFORM_K8V4, _PRESET_RQ_UNIFORM_K4V4):
+        if block_size % RQ_UNIFORM_K8V4_SUB_BLOCK_ROWS != 0:
+            raise ValueError(
+                f"{cache_dtype} on Ascend requires block_size to be a "
+                f"multiple of {RQ_UNIFORM_K8V4_SUB_BLOCK_ROWS}, got {block_size}"
+            )
+        groups = block_size // RQ_UNIFORM_K8V4_SUB_BLOCK_ROWS
+        if cache_dtype == _PRESET_RQ_UNIFORM_K8V4:
+            if not rq_uniform_k8v4_head_size_ok(head_size):
+                raise ValueError(
+                    f"rq_k8v4_uq on Ascend requires head_size in "
+                    f"{_TQ_HEAD_SIZES}, got {head_size}"
+                )
+            key_stride = groups * k8v4_key_block_stride(head_size)
+            value_stride = groups * k8v4_value_block_stride(head_size)
+        else:
+            if head_size != _TQ_K4V4_HEAD_SIZE:
+                raise ValueError(
+                    f"rq_4bit_uq on Ascend requires head_size="
+                    f"{_TQ_K4V4_HEAD_SIZE}, got {head_size}"
+                )
+            # K4V4: key and value share the int4 slab geometry (1088 B per
+            # 16-token group per head).
+            key_stride = groups * RQ_UNIFORM_K8V4_SUB_BLOCK_ROWS * 68
+            value_stride = key_stride
+    else:
+        raise ValueError(
+            f"Unsupported RqUniform cache dtype on Ascend NPU: {cache_dtype!r}. "
+            f"Supported presets: {', '.join(_SUPPORTED_PRESETS)}."
+        )
+    return key_stride, value_stride, (key_stride + value_stride) // block_size
+
+
+def build_ascend_rq_uniform_kv_spec(
+    *, block_size: int, num_kv_heads: int, cache_dtype: str, head_size: int = 128
+) -> "TQFullAttentionSpec":
+    """Build the KV cache spec with the Ascend operator slab strides.
+
+    The upstream spec uses the CUDA slot layout (``[key | value]`` per
+    position); the Ascend operators use per-head K/V slabs with different
+    packed widths, so ``head_size``/``head_size_v`` carry the slab strides
+    (bytes) and ``tq_slot_size`` the exact per-token footprint for memory
+    accounting. The model runner splits the raw storage proportionally to
+    ``head_size``/``head_size_v``, producing the two contiguous uint8 slabs
+    the operators require. ``head_size`` is the model's real head dim
+    (128 or 256 for k8v4).
+    """
+    from vllm.v1.kv_cache_interface import TQFullAttentionSpec
+
+    key_stride, value_stride, slot_bytes = ascend_rq_uniform_cache_strides(
+        cache_dtype, block_size, head_size
+    )
+    return TQFullAttentionSpec(
+        block_size=block_size,
+        num_kv_heads=num_kv_heads,
+        head_size=key_stride,
+        head_size_v=value_stride,
+        dtype=torch.uint8,
+        tq_slot_size=slot_bytes,
+    )
+
+
+class AscendRqUniformBackend(AttentionBackend):
+    """RqUniform attention backend backed by openjiuwen_ascend_ops operators."""
+
+    accept_output_buffer: bool = True
+    # Quantize + pack happens inside forward (matches AscendAttentionBackend).
+    forward_includes_kv_cache_update: bool = True
+
+    supported_kv_cache_dtypes = list(_SUPPORTED_PRESETS)
+
+    @staticmethod
+    def get_name() -> str:
+        # HACK: vllm's attention selector / model runner look the backend
+        # name up in AttentionBackendEnum, which only knows upstream names.
+        # Follow the fa3_v1 convention and report CUSTOM (the designated
+        # plugin escape hatch); dispatch is by class path from the platform.
+        return "CUSTOM"
+
+    @staticmethod
+    def get_impl_cls() -> type[AscendRqUniformAttentionImpl]:
+        return AscendRqUniformAttentionImpl
+
+    @staticmethod
+    def get_builder_cls() -> type[AttentionMetadataBuilder]:
+        # Reuse the standard Ascend metadata builder: it already produces the
+        # FIA attention mask, block tables, slot mapping and sequence-length
+        # bookkeeping this backend consumes.
+        return AscendAttentionMetadataBuilder
+
+    @staticmethod
+    def get_kv_cache_shape(
+        num_blocks: int,
+        block_size: int,
+        num_kv_heads: int,
+        head_size: int,
+        cache_dtype_str: str = "",
+    ) -> tuple[int, ...]:
+        """Leading-dim-2 shape; the runner views ``kv_cache[0]``/``kv_cache[1]``
+        as the key/value slabs of shape ``(num_blocks, num_kv_heads, stride)``.
+
+        ``head_size`` arrives from the spec and is the per-head KEY slab stride
+        in bytes (see :func:`ascend_rq_uniform_cache_strides`).
+        """
+        return (2, num_blocks, num_kv_heads, head_size)
+
+    @staticmethod
+    def get_supported_kernel_block_sizes() -> list[int]:
+        return [16, 32, 64, 128]
+
+    @staticmethod
+    def swap_blocks(
+        src_kv_cache: list[torch.Tensor],
+        dst_kv_cache: list[torch.Tensor],
+        src_to_dst: torch.Tensor,
+    ) -> None:
+        # Same block-indexing semantics as AscendAttentionBackend: dim 0 of
+        # each slab is the block index.
+        src_key_cache, src_value_cache = src_kv_cache[0], src_kv_cache[1]
+        dst_key_cache, dst_value_cache = dst_kv_cache[0], dst_kv_cache[1]
+        src_indices = src_to_dst[:, 0]
+        dst_indices = src_to_dst[:, 1]
+
+        dst_key_cache[dst_indices] = src_key_cache[src_indices].to(dst_key_cache.device)
+        dst_value_cache[dst_indices] = src_value_cache[src_indices].to(dst_key_cache.device)
+
+    @staticmethod
+    def copy_blocks(
+        kv_caches: list[torch.Tensor],
+        src_to_dists: torch.Tensor,
+    ) -> None:
+        src_indices = src_to_dists[:, 0]
+        dst_indices = src_to_dists[:, 1]
+
+        for kv_cache in kv_caches:
+            key_caches = kv_cache[0]
+            value_caches = kv_cache[1]
+            key_caches[dst_indices] = key_caches[src_indices]
+            value_caches[dst_indices] = value_caches[src_indices]
+
+    @classmethod
+    def supports_attn_type(cls, attn_type: str) -> bool:
+        return attn_type == AttentionType.DECODER
+
+    @classmethod
+    def supports_kv_cache_dtype(cls, kv_cache_dtype) -> bool:
+        return kv_cache_dtype in _SUPPORTED_PRESETS
+
+
+class AscendRqUniformAttentionImpl(AttentionImpl[AscendMetadata]):
+    """RqUniform attention implementation over the packed KV cache."""
+
+    # Tensors built during update_graph_params (fresh slot casts, cu_seqlens
+    # aranges, sliced key/value views) must outlive the update call — the
+    # graph replay reads them afterwards. Reset at the start of every update.
+    _update_scratch: list = []
+
+    def __init__(
+        self,
+        num_heads: int,
+        head_size: int,
+        scale: float,
+        num_kv_heads: int | None = None,
+        alibi_slopes: list[float] | None = None,
+        sliding_window: int | None = None,
+        kv_cache_dtype: str = "auto",
+        logits_soft_cap: float | None = None,
+        attn_type: str = AttentionType.DECODER,
+        kv_sharing_target_layer_name: str | None = None,
+        **kwargs,
+    ):
+        if head_size not in _TQ_HEAD_SIZES:
+            raise ValueError(
+                f"Ascend RqUniform backends require head_size in "
+                f"{_TQ_HEAD_SIZES}, got {head_size}"
+            )
+        if sliding_window is not None:
+            raise ValueError(
+                "Sliding-window attention is not supported by the Ascend "
+                "RqUniform backend"
+            )
+        if alibi_slopes is not None:
+            raise ValueError(
+                "ALiBi is not supported by the Ascend RqUniform backend"
+            )
+        # Boundary-skip layers are constructed with kv_cache_dtype="auto";
+        # the Ascend spec patch normalizes every layer of a RqUniform run to
+        # the engine-wide preset (see ModelRunner.get_kv_cache_spec), so fall
+        # back to the engine cache dtype here.
+        if kv_cache_dtype == "auto" or kv_cache_dtype is None:
+            kv_cache_dtype = get_current_vllm_config().cache_config.cache_dtype
+        if kv_cache_dtype not in _SUPPORTED_PRESETS:
+            raise ValueError(
+                f"Unsupported RqUniform cache dtype on Ascend NPU: "
+                f"{kv_cache_dtype!r}. Supported presets: "
+                f"{', '.join(_SUPPORTED_PRESETS)}."
+            )
+        # openjiuwen OPP wiring is done once in NPUPlatform.check_and_update_config
+        # via ensure_jiuwen_ops(); do not re-probe per backend.
+
+        self.num_heads = num_heads
+        self.head_size = head_size
+        self.scale = scale
+        self.num_kv_heads = num_kv_heads if num_kv_heads is not None else num_heads
+        self.kv_cache_dtype = kv_cache_dtype
+        self.attn_type = attn_type
+        self.block_size = get_current_vllm_config().cache_config.block_size
+        self.key_stride, self.value_stride, _ = ascend_rq_uniform_cache_strides(
+            kv_cache_dtype, self.block_size, head_size
+        )
+        logger.info_once(
+            "Ascend RqUniform backend: preset=%s, block_size=%d, "
+            "key_stride=%d, value_stride=%d",
+            kv_cache_dtype,
+            self.block_size,
+            self.key_stride,
+            self.value_stride,
+        )
+
+    # ------------------------------------------------------------------ #
+    #  KV cache update: quantize + pack into the compressed cache        #
+    # ------------------------------------------------------------------ #
+    def reshape_and_cache(
+        self,
+        key: torch.Tensor,
+        value: torch.Tensor,
+        kv_cache: tuple[torch.Tensor, ...],
+        attn_metadata: AscendMetadata,
+    ) -> None:
+        """Pack the current-step K/V into the compressed cache."""
+        num_tokens = attn_metadata.num_actual_tokens
+        if num_tokens <= 0:
+            return
+        key_cache, value_cache = self._split_kv_cache(kv_cache)
+        slot_mapping = attn_metadata.slot_mapping[:num_tokens]
+        query_start_loc = self._pack_query_start_loc(attn_metadata)
+        num_reqs = query_start_loc.shape[0] - 1
+
+        rotation_t, _ = rq_uniform_rotation_tables(
+            key.device, key.dtype, self.head_size
+        )
+
+        if _EXTRA_CTX.capturing:
+            # FULL-mode capture: record the pack launch in a graph task
+            # group. slot_mapping is a per-step tensor (fresh pointer every
+            # step), so update_graph_params MUST re-record this launch with
+            # the current metadata — otherwise replayed decode steps keep
+            # writing to the capture-time slots and the cache stops
+            # growing (degenerate repetition after a few tokens).
+            self._capture_pack(
+                key[:num_tokens],
+                value[:num_tokens],
+                slot_mapping,
+                query_start_loc,
+                rotation_t,
+                key_cache,
+                value_cache,
+                num_reqs,
+                num_tokens,
+            )
+            return
+
+        jiuwen_op(self._pack_op_name())(
+            key[:num_tokens],
+            value[:num_tokens],
+            slot_mapping.to(torch.int32),
+            query_start_loc,
+            rotation_t,
+            key_cache,
+            value_cache,
+            num_reqs,
+            self._ops_block_size(key_cache),
+        )
+
+    def _capture_pack(
+        self,
+        key_view: torch.Tensor,
+        value_view: torch.Tensor,
+        slot_mapping: torch.Tensor,
+        query_start_loc: torch.Tensor,
+        rotation_t: torch.Tensor,
+        key_cache: torch.Tensor,
+        value_cache: torch.Tensor,
+        num_reqs: int,
+        num_tokens: int,
+    ) -> None:
+        """Capture the pack op into a graph task group (re-recorded per step).
+
+        The int64 persistent slot_mapping crosses into the op as an int32
+        CAST (``.to(torch.int32)`` allocates a fresh tensor). Whether that
+        cast replays with the graph is not guaranteed, so the captured
+        launch may otherwise keep reading the capture-time slot snapshot —
+        with concurrent requests the slot assignment changes every step and
+        decode degenerates into repetition. update_graph_params therefore
+        re-records this launch with the CURRENT step's slot mapping (and
+        the real, unpadded token count).
+        """
+        graph_params = get_graph_params()
+        stream = torch_npu.npu.current_stream()
+
+        event = torch.npu.ExternalEvent()
+        event.wait(stream)
+        event.reset(stream)
+        graph_params.events[num_tokens].append(event)
+        # (kind, layer_name, pack_op_name, key, value, rotation_t,
+        #  key_cache, value_cache, block_size)
+        graph_params.attn_params[num_tokens].append(
+            (
+                "pack",
+                getattr(self, "_graph_layer_name", None),
+                self._pack_op_name(),
+                weak_ref_tensors(key_view),
+                weak_ref_tensors(value_view),
+                weak_ref_tensors(rotation_t),
+                weak_ref_tensors(key_cache),
+                weak_ref_tensors(value_cache),
+                self._ops_block_size(key_cache),
+            )
+        )
+
+        torch.npu.graph_task_group_begin(stream)
+        jiuwen_op(self._pack_op_name())(
+            key_view,
+            value_view,
+            slot_mapping.to(torch.int32),
+            query_start_loc,
+            rotation_t,
+            key_cache,
+            value_cache,
+            num_reqs,
+            self._ops_block_size(key_cache),
+        )
+        handle = torch.npu.graph_task_group_end(stream)
+        graph_params.handles[num_tokens].append(handle)
+
+    def _pack_op_name(self) -> str:
+        return (
+            "rq_uniform_pack_k8v4"
+            if self.kv_cache_dtype == _PRESET_RQ_UNIFORM_K8V4
+            else "rq_uniform_pack_k4v4"
+        )
+
+    def _fia_suffix(self) -> str:
+        return (
+            "k8v4" if self.kv_cache_dtype == _PRESET_RQ_UNIFORM_K8V4 else "k4v4"
+        )
+
+    def _ops_block_size(self, key_cache: torch.Tensor) -> int:
+        """Block size the operators must use for THIS cache tensor.
+
+        Hybrid (attention + mamba) models store several 128-token kernel
+        pages inside one physical hybrid page; the ops must be told the
+        kernel-page token count (from the cache geometry), not the physical
+        scheduler block size.
+        """
+        if (
+            self.kv_cache_dtype == _PRESET_RQ_UNIFORM_K8V4
+            and key_cache is not None
+            and key_cache.ndim == 3
+        ):
+            from vllm_ascend.hybrid_kv_page import k8v4_cache_page_tokens
+
+            return k8v4_cache_page_tokens(key_cache, self.head_size)
+        return self.block_size
+
+    def _pack_query_start_loc(self, attn_metadata: AscendMetadata) -> torch.Tensor:
+        """cu_seqlens over the tokens actually being packed.
+
+        ``actual_seq_lengths_q`` may carry a trailing dummy request from
+        batch padding whose range starts at/after ``num_actual_tokens``;
+        trim those entries so every request maps to a non-empty token range
+        of the sliced key/value.
+
+        Uniform single-token batches (every decode step, and always under
+        ACL graph capture) reduce to ``[0, 1, ..., n]`` — built with a
+        device-side arange. ``torch.tensor(host_list)`` performs an H2D
+        copy, which is illegal during capture in GLOBAL mode (EZ1009 /
+        "stream is captured") and a needless sync in eager mode.
+        """
+        num_tokens = attn_metadata.num_actual_tokens
+        ends = [e for e in attn_metadata.actual_seq_lengths_q if 0 < e <= num_tokens]
+        if not ends or ends[-1] != num_tokens:
+            ends.append(num_tokens)
+        device = attn_metadata.query_start_loc.device
+        if ends == list(range(1, len(ends) + 1)):
+            return torch.arange(len(ends) + 1, dtype=torch.int32, device=device)
+        if _EXTRA_CTX.capturing:
+            raise NotImplementedError(
+                "ACL graph capture only supports uniform single-token "
+                "decode batches for the Ascend RqUniform pack path"
+            )
+        return torch.tensor(
+            [0, *ends], dtype=torch.int32, device=device
+        )
+
+    def _split_kv_cache(
+        self, kv_cache
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        """Return the (key_cache, value_cache) uint8 slabs."""
+        if isinstance(kv_cache, (tuple, list)):
+            return kv_cache[0], kv_cache[1]
+        # A leading-dim-2 tensor: split the two slabs.
+        return kv_cache[0], kv_cache[1]
+
+    # ------------------------------------------------------------------ #
+    #  Attention                                                         #
+    # ------------------------------------------------------------------ #
+    def forward(
+        self,
+        layer: AttentionLayer,
+        query: torch.Tensor,
+        key: torch.Tensor,
+        value: torch.Tensor,
+        kv_cache,
+        attn_metadata: AscendMetadata,
+        output: torch.Tensor | None = None,
+        output_scale: torch.Tensor | None = None,
+        output_block_scale: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        if output is None:
+            output = torch.zeros(
+                query.shape[0],
+                self.num_heads * self.head_size,
+                dtype=query.dtype,
+                device=query.device,
+            )
+        if attn_metadata is None:
+            # Dummy/warmup run without attention metadata (mirrors the
+            # upstream RqUniform backend guard): nothing to attend to.
+            return output.fill_(0)
+        num_tokens = attn_metadata.num_actual_tokens
+        if num_tokens <= 0:
+            return output
+
+        # Layer name for graph-param refresh: captured entries re-record
+        # with THIS layer's per-step metadata on replay.
+        self._graph_layer_name = getattr(layer, "layer_name", None)
+
+        # Quantize + store the current-step K/V before attention reads them.
+        self.reshape_and_cache(key, value, kv_cache, attn_metadata)
+
+        if attn_metadata.attn_state == AscendAttentionState.PrefillNoCache:
+            # Raw tensors: the helper slices to the query cumsum, which can
+            # exceed num_actual_tokens under scheduler padding.
+            attn_out = self._prefill_no_cache_attention(query, key, value, attn_metadata)
+            rows = attn_out.shape[0]
+            output[:rows] = attn_out.to(output.dtype)
+            return output
+
+        query = query[:num_tokens].contiguous()
+        key_cache, value_cache = self._split_kv_cache(kv_cache)
+        attn_out = self._compressed_cache_attention(
+            query, key_cache, value_cache, attn_metadata
+        )
+        # output arrives as a 3D (num_tokens, num_heads, head_size) view.
+        output[:num_tokens] = attn_out.to(output.dtype)
+        return output
+
+    def _prefill_no_cache_attention(
+        self,
+        query: torch.Tensor,
+        key: torch.Tensor,
+        value: torch.Tensor,
+        attn_metadata: AscendMetadata,
+    ) -> torch.Tensor:
+        """First-chunk prefill: full-precision FIA over the fresh K/V.
+
+        For PrefillNoCache the step's K/V is exactly the query chunk, so
+        mirror the standard backend: token count = the LAST element of the
+        query cumsum, and the KV seq lens are the query lens themselves.
+        ``num_actual_tokens`` may differ from that cumsum under scheduler
+        padding (flashcomm inserts a dummy request into query_start_loc on
+        concurrent batches), and FIA TND then rejects the launch with
+        "keyT/valueT must equal the last element of actualSeqenceLengthKV".
+        """
+        num_tokens = attn_metadata.actual_seq_lengths_q[-1]
+        attn_output, _ = torch_npu.npu_fused_infer_attention_score(
+            query=query[:num_tokens],
+            key=key[:num_tokens].contiguous(),
+            value=value[:num_tokens].contiguous(),
+            atten_mask=attn_metadata.attn_mask,
+            input_layout="TND",
+            num_heads=self.num_heads,
+            num_key_value_heads=self.num_kv_heads,
+            scale=self.scale,
+            actual_seq_lengths=attn_metadata.actual_seq_lengths_q,
+            actual_seq_lengths_kv=attn_metadata.actual_seq_lengths_q,
+            sparse_mode=3,
+        )
+        return attn_output.view(num_tokens, self.num_heads, self.head_size)
+
+    def _compressed_cache_attention(
+        self,
+        query: torch.Tensor,
+        key_cache: torch.Tensor,
+        value_cache: torch.Tensor,
+        attn_metadata: AscendMetadata,
+    ) -> torch.Tensor:
+        """Attention over the packed cache via the jiuwen operators."""
+        block_table = attn_metadata.block_tables.contiguous()
+        rotation_key, rotation_value = rq_uniform_rotation_tables(
+            query.device, query.dtype, self.head_size
+        )
+        suffix = self._fia_suffix()
+        is_decode = attn_metadata.attn_state == AscendAttentionState.DecodeOnly
+
+        if _EXTRA_CTX.capturing:
+            # FULL-mode ACL graph capture: record the decode-op launch in a
+            # graph task group so per-step sequence lengths can be refreshed
+            # on replay (see update_graph_params).
+            return self._capture_decode_attention(
+                query,
+                key_cache,
+                value_cache,
+                block_table,
+                rotation_key,
+                rotation_value,
+                attn_metadata,
+                suffix,
+            )
+
+        if is_decode:
+            # Decode: sparse_mode=0, no mask (single query token per request
+            # attends to its full history). MSD kernel on A2/A3; base FIA on A5.
+            attn_out = jiuwen_op(_fia_decode_op_name(suffix))(
+                query,
+                key_cache,
+                value_cache,
+                block_table,
+                attn_metadata.actual_seq_lengths_q,
+                attn_metadata.seq_lens_list,
+                None,
+                rotation_key,
+                rotation_value,
+                self.num_heads,
+                self.num_kv_heads,
+                self.head_size,
+                self._ops_block_size(key_cache),
+                self.scale,
+                SWA_INT_MAX,
+                SWA_INT_MAX,
+                0,
+            )
+        else:
+            attn_out = jiuwen_op(f"rq_uniform_fia_paged_{suffix}")(
+                query,
+                key_cache,
+                value_cache,
+                block_table,
+                attn_metadata.actual_seq_lengths_q,
+                attn_metadata.seq_lens_list,
+                attn_metadata.attn_mask,
+                rotation_key,
+                rotation_value,
+                self.num_heads,
+                self.num_kv_heads,
+                self.head_size,
+                self._ops_block_size(key_cache),
+                self.scale,
+                SWA_INT_MAX,
+                SWA_INT_MAX,
+                3,
+            )
+        return attn_out.view(query.shape[0], self.num_heads, self.head_size)
+
+    # ------------------------------------------------------------------ #
+    #  ACL graph capture / replay update                                 #
+    # ------------------------------------------------------------------ #
+    def _capture_decode_attention(
+        self,
+        query: torch.Tensor,
+        key_cache: torch.Tensor,
+        value_cache: torch.Tensor,
+        block_table: torch.Tensor,
+        rotation_key: torch.Tensor,
+        rotation_value: torch.Tensor,
+        attn_metadata: AscendMetadata,
+        suffix: str,
+    ) -> torch.Tensor:
+        """Capture the decode attention op into a graph task group.
+
+        Mirrors the upstream paged-attention full-graph path: the op launch
+        is bracketed by ``graph_task_group_begin/end`` and its parameters are
+        recorded so ``update_graph_params`` can re-record the launch with
+        fresh sequence lengths before every replay. The output is an
+        explicitly allocated buffer (stable address across replay).
+        """
+        if attn_metadata.attn_state != AscendAttentionState.DecodeOnly:
+            raise NotImplementedError(
+                "Ascend RqUniform ACL graph capture only supports the "
+                f"DecodeOnly state, got {attn_metadata.attn_state}"
+            )
+        if _EXTRA_CTX.is_draft_model:
+            raise NotImplementedError(
+                "Ascend RqUniform ACL graph capture does not support "
+                "speculative draft models yet"
+            )
+        graph_params = get_graph_params()
+        num_tokens = query.shape[0]
+        stream = torch_npu.npu.current_stream()
+
+        event = torch.npu.ExternalEvent()
+        event.wait(stream)
+        event.reset(stream)
+        graph_params.events[num_tokens].append(event)
+        # (kind, layer_name, query, key_cache, value_cache, block_table,
+        #  rotation_key, rotation_value, num_heads, num_kv_heads, head_size,
+        #  block_size, scale, out, suffix)
+        attn_out = torch.empty_like(query)
+        graph_params.attn_params[num_tokens].append(
+            (
+                "msd",
+                getattr(self, "_graph_layer_name", None),
+                weak_ref_tensors(query),
+                weak_ref_tensors(key_cache),
+                weak_ref_tensors(value_cache),
+                weak_ref_tensors(block_table),
+                weak_ref_tensors(rotation_key),
+                weak_ref_tensors(rotation_value),
+                self.num_heads,
+                self.num_kv_heads,
+                self.head_size,
+                self._ops_block_size(key_cache),
+                self.scale,
+                weak_ref_tensors(attn_out),
+                suffix,
+            )
+        )
+
+        torch.npu.graph_task_group_begin(stream)
+        jiuwen_op(_fia_decode_op_name(suffix))(
+            query,
+            key_cache,
+            value_cache,
+            block_table,
+            attn_metadata.actual_seq_lengths_q,
+            attn_metadata.seq_lens_list,
+            None,
+            rotation_key,
+            rotation_value,
+            self.num_heads,
+            self.num_kv_heads,
+            self.head_size,
+            self._ops_block_size(key_cache),
+            self.scale,
+            SWA_INT_MAX,
+            SWA_INT_MAX,
+            0,
+            attn_out,
+        )
+        handle = torch.npu.graph_task_group_end(stream)
+        graph_params.handles[num_tokens].append(handle)
+        return attn_out
+
+    @classmethod
+    def update_graph_params(
+        cls,
+        update_stream,
+        forward_context,
+        num_tokens,
+        vllm_config,
+        speculative_config=None,
+        num_dcp_pcp_tokens=None,
+        draft_attn_metadatas=None,
+    ):
+        """Re-record every captured op with the current step's metadata.
+
+        Called by the model runner on the update stream before each FULL
+        graph replay. Per-step tensors change identity every step (the
+        builder builds fresh tensors), so BOTH captured launch kinds must be
+        re-recorded with the CURRENT metadata:
+
+        * ``pack`` — fresh ``slot_mapping``; without this, replayed decode
+          steps keep writing to the capture-time slots and the cache stops
+          growing (degenerate repetition after a few tokens).
+        * ``msd`` — fresh ``block_tables`` and ``seq_lens_list`` /
+          ``actual_seq_lengths_q`` (the capture bakes dummy values from
+          ``build_for_graph_capture``).
+
+        Static per-graph buffers (key/value projections, caches, rotations,
+        our arange cu_seqlens, the output buffer) are reused from the
+        captured params. Entries are resolved to their metadata by the
+        layer name stored at capture time; unknown names fall back to
+        cycling through the metadata dict in insertion order (all RQ layers
+        share the same seq_lens anyway).
+        """
+        graph_params = get_graph_params()
+        captured_attn_params = graph_params.attn_params.get(num_tokens) or []
+        handles = graph_params.handles.get(num_tokens) or []
+        events = graph_params.events.get(num_tokens) or []
+        # The previous step's replay has completed (the runner synchronizes
+        # before replay), so its scratch tensors are dead — drop them.
+        cls._update_scratch = []
+        if not captured_attn_params:
+            return
+        attn_metadata = forward_context.attn_metadata
+        if not attn_metadata:
+            logger.warning_once(
+                "Ascend RqUniform update_graph_params: forward context has "
+                "no attention metadata; skipping refresh (replay would use "
+                "stale capture-time parameters)"
+            )
+            return
+        meta_values = list(attn_metadata.values())
+        fallback_idx = 0
+        with torch.npu.stream(update_stream):
+            for param, handle, event in zip(
+                captured_attn_params, handles, events
+            ):
+                kind = param[0]
+                layer_name = param[1]
+                meta = (
+                    attn_metadata.get(layer_name)
+                    if layer_name is not None and layer_name in attn_metadata
+                    else None
+                )
+                if meta is None:
+                    meta = meta_values[fallback_idx % len(meta_values)]
+                    fallback_idx += 1
+
+                if kind == "pack":
+                    (
+                        _,
+                        _,
+                        pack_op_name,
+                        key_view,
+                        value_view,
+                        rotation_t,
+                        key_cache,
+                        value_cache,
+                        block_size,
+                    ) = param
+                    # Replay metadata is UNPADDED (real tokens only) while the
+                    # captured views span the padded graph size: slice to the
+                    # real count and rebind the CURRENT slot mapping (the
+                    # int32 cast snapshot baked at capture goes stale as soon
+                    # as concurrent requests change the slot assignment).
+                    fresh_slots = meta.slot_mapping.to(torch.int32)
+                    num_real_tokens = fresh_slots.shape[0]
+                    fresh_qsl = torch.arange(
+                        num_real_tokens + 1,
+                        dtype=torch.int32,
+                        device=key_view.device,
+                    )
+                    fresh_key = key_view[:num_real_tokens]
+                    fresh_value = value_view[:num_real_tokens]
+                    cls._update_scratch.append(
+                        (fresh_slots, fresh_qsl, fresh_key, fresh_value)
+                    )
+                    torch.npu.graph_task_update_begin(update_stream, handle)
+                    jiuwen_op(pack_op_name)(
+                        fresh_key,
+                        fresh_value,
+                        fresh_slots,
+                        fresh_qsl,
+                        rotation_t,
+                        key_cache,
+                        value_cache,
+                        num_real_tokens,
+                        block_size,
+                    )
+                    torch.npu.graph_task_update_end(update_stream)
+                    event.record(update_stream)
+                    continue
+
+                (
+                    _,
+                    _,
+                    query,
+                    key_cache,
+                    value_cache,
+                    block_table,  # persistent runner buffer; still valid
+                    rotation_key,
+                    rotation_value,
+                    num_heads,
+                    num_kv_heads,
+                    head_size,
+                    block_size,
+                    scale,
+                    attn_out,
+                    suffix,
+                ) = param
+                torch.npu.graph_task_update_begin(update_stream, handle)
+                # The baked HOST lists (seq lens) AND the block table change
+                # per step — unlike slot_mapping (a persistent runner buffer
+                # the metadata slices in place), the metadata block_tables
+                # may be a freshly-built/padded tensor each step, so the
+                # re-record must bind the CURRENT tensor's address. The other
+                # device tensors (query/caches/rotations/out) are genuine
+                # persistent buffers or graph inputs — reuse the captured ones.
+                jiuwen_op(_fia_decode_op_name(suffix))(
+                    query,
+                    key_cache,
+                    value_cache,
+                    meta.block_tables.contiguous(),
+                    meta.actual_seq_lengths_q,
+                    meta.seq_lens_list,
+                    None,
+                    rotation_key,
+                    rotation_value,
+                    num_heads,
+                    num_kv_heads,
+                    head_size,
+                    block_size,
+                    scale,
+                    SWA_INT_MAX,
+                    SWA_INT_MAX,
+                    0,
+                    attn_out,
+                )
+                torch.npu.graph_task_update_end(update_stream)
+                event.record(update_stream)
+
+    # ------------------------------------------------------------------ #
+    #  Unused hooks (kept for interface compatibility)                   #
+    # ------------------------------------------------------------------ #
+    def process_weights_after_loading(self, act_dtype: torch.dtype) -> None:
+        pass
